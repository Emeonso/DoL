:: Combat Haggle Summary [widget]
<<widget "combatHaggleSummary">>
<<if $combatHaggleLast isnot undefined>>
<p class="combat-haggle-summary">You agreed to provide
<<switch $combatHaggleLast.offer>><<case "oral">>oral sex<<case "oral_virginity">>your oral virginity<<case "penile">>penile sex<<case "penile_virginity">>your penile virginity<<case "vaginal">>vaginal sex<<case "vaginal_virginity">>your vaginal virginity<<case "anal">>anal sex<<case "anal_virginity">>your anal virginity<<default>>the agreed service<</switch>> for an additional <<printmoney $combatHaggleLast.amount>>.</p>
<</if>>
<</widget>>

::Combat Haggle
<<if $combatHaggle is undefined>><<set $combatHaggle to {status: "open", pauseNow: false, returnPassage: "", result: "", offerId: "", amount: 0, target: 0, proposal: {}}>><</if>><<set _link to true>>
<div id="hagglePanel" class="combat-haggle-panel">
<<if $combatHaggle.status is "open">>
<p><<if $enemyanger gte 100>><span class="red"><<He $combatHaggle.target>> looks utterly unimpressed. This may be a hard sell.</span><<elseif $enemyanger gte 60>><span class="pink"><<He $combatHaggle.target>> looks doubtful, but there may still be a chance.</span><<elseif $enemyanger gte 40>><span class="purple"><<He $combatHaggle.target>> seems only mildly interested. You will need to tempt <<him $combatHaggle.target>>.</span><<elseif $enemyanger gte 30>><span class="blue"><<He $combatHaggle.target>> watches you with cautious interest.</span><<elseif $enemyanger gte 20>><span class="lblue"><<His $combatHaggle.target>> attention lingers on you. <<He $combatHaggle.target>> may be persuadable.</span><<elseif $enemyanger gte 10>><span class="teal"><<He $combatHaggle.target>> looks eager to hear what you have in mind.</span><<else>><span class="green"><<He $combatHaggle.target>> looks captivated. <<He $combatHaggle.target>> is clearly interested in your offer.</span><</if>></p>
<div><strong>Your offer</strong><br>
<<set _haggleNpc to $NPCList[$combatHaggle.target]>><<set _mouthFree to [$mouthuse,0,"free"].includes($mouthuse)>><<set _genitals to ((_haggleNpc.penis isnot "none" or _haggleNpc.vagina isnot "none") and _haggleNpc.location.genitals isnot "head")>>
<<if _mouthFree and _genitals>><label><<radiobutton "$combatHaggle.offerId" "oral">> Offer your mouth</label> | <</if>><<if _mouthFree and _genitals and $player.virginity.oral is true>><label><<radiobutton "$combatHaggle.offerId" "oral_virginity">> Give <<him $combatHaggle.target>> your oral virginity</label> | <</if>><<if ($player.penisExist or playerHasStrapon()) and $penilechastity is 0 and $penisstate isnot "penetrated" and (_haggleNpc.vagina isnot "none" or _haggleNpc.location.anus isnot "none")>><label><<radiobutton "$combatHaggle.offerId" "penile">> Offer your cock</label> | <</if>><<if ($player.penisExist or playerHasStrapon()) and $penilechastity is 0 and $penisstate isnot "penetrated" and (_haggleNpc.vagina isnot "none" or _haggleNpc.location.anus isnot "none") and $player.virginity.penile is true>><label><<radiobutton "$combatHaggle.offerId" "penile_virginity">> Give <<him $combatHaggle.target>> your penile virginity</label> | <</if>><<if $player.vaginaExist and $vaginalchastity is 0 and $vaginastate isnot "penetrated" and _haggleNpc.penis isnot "none">><label><<radiobutton "$combatHaggle.offerId" "vaginal">> Offer your pussy</label> | <</if>><<if $player.vaginaExist and $vaginalchastity is 0 and $vaginastate isnot "penetrated" and _haggleNpc.penis isnot "none" and $player.virginity.vaginal is true>><label><<radiobutton "$combatHaggle.offerId" "vaginal_virginity">> Give <<him $combatHaggle.target>> your vaginal virginity</label> | <</if>><<if $analchastity is 0 and $anusstate isnot "penetrated" and _haggleNpc.penis isnot "none">><label><<radiobutton "$combatHaggle.offerId" "anal">> Offer your ass</label> | <</if>><<if $analchastity is 0 and $anusstate isnot "penetrated" and _haggleNpc.penis isnot "none" and $player.virginity.anal is true>><label><<radiobutton "$combatHaggle.offerId" "anal_virginity">> Give <<him $combatHaggle.target>> your anal virginity</label><</if>><br>
<<if $combatHaggle.offerId is "">><span class="yellow">Choose what you will offer.</span><<else>><span class="green">Selected: <<switch $combatHaggle.offerId>><<case "oral">>your mouth<<case "oral_virginity">>your oral virginity<<case "penile">>your cock<<case "penile_virginity">>your penile virginity<<case "vaginal">>your pussy<<case "vaginal_virginity">>your vaginal virginity<<case "anal">>your ass<<case "anal_virginity">>your anal virginity<<default>>your body<</switch>></span><</if>></div><br>
<div><strong>His payment</strong><br><label><<radiobutton "$combatHaggle.amount" 2500>> £25</label> | <label><<radiobutton "$combatHaggle.amount" 5000>> £50</label> | <label><<radiobutton "$combatHaggle.amount" 7500>> £75</label> | <label><<radiobutton "$combatHaggle.amount" 10000>> £100</label> | <label><<radiobutton "$combatHaggle.amount" 15000>> £150</label><br><<if $combatHaggle.amount gt 0>><span class="green">Selected payment: <<printmoney $combatHaggle.amount>></span><<else>><span class="yellow">Choose a payment.</span><</if>></div><br>
<div style="display:flex;justify-content:space-between;align-items:center;margin-top:1em;"><span><<link "Submit proposal">><<if $combatHaggle.offerId is "" or $combatHaggle.amount lte 0>><span class="red">Choose one offer and one amount first.</span><<else>><<set $combatHaggleMade to true>><<set $combatHaggle.proposal to {offer:$combatHaggle.offerId,amount:$combatHaggle.amount,target:$combatHaggle.target}>><<set $combatHaggle.result to ($enemyanger lt 50 ? "accepted" : "declined")>><<if $combatHaggle.result is "accepted">><<set $tip += $combatHaggle.amount>><<set $combatHaggleLast to {offer:$combatHaggle.offerId,amount:$combatHaggle.amount}>><</if>><<set $combatHaggle.status to "resolved">><<replace "#hagglePanel">><<include "Combat Haggle">><</replace>><</if>><</link>></span>
<<if $combatHaggle.returnPassage isnot "" and Story.has($combatHaggle.returnPassage)>><span><<link "Cancel">><<set _returnPassage to $combatHaggle.returnPassage>><<set $combatHaggle.pauseNow to false>><<set $combatHaggle.status to "idle">><<unset $nextPassage>><<set $mouthaction to 0>><<set $mouthactiondefault to "rest">><<run Engine.play(_returnPassage)>><</link>></span><</if>></div>
<<elseif $combatHaggle.status is "resolved">><<if $combatHaggle.result is "accepted">><p><span class="green">The NPC accepts your proposal.</span></p><<else>><p><span class="red">The NPC declines your proposal.</span></p><</if>><p>This placeholder response performs no payment or sexual action.</p><<if $combatHaggle.returnPassage isnot "" and Story.has($combatHaggle.returnPassage)>><<set $nextPassage to $combatHaggle.returnPassage>><<link "Return to combat">><<set _returnPassage to $combatHaggle.returnPassage>><<set $combatHaggle.pauseNow to false>><<set $combatHaggle.status to "idle">><<unset $nextPassage>><<set $mouthaction to 0>><<set $mouthactiondefault to "rest">><<run Engine.play(_returnPassage)>><</link>><<else>><<dialog "Haggle unavailable">>The original combat passage could not be restored safely.<</dialog>><</if>><</if>></div>
