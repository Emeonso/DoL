:: Combat Haggle Summary [widget]
<<widget "combatHaggleSummary">>
<<if $combatHaggleLast isnot undefined>>
<p class="combat-haggle-summary">You agreed to provide
<<switch $combatHaggleLast.offer>><<case "oral">>oral sex<<case "oral_virginity">>your oral virginity<<case "penile">>penile sex<<case "penile_virginity">>your penile virginity<<case "vaginal">>vaginal sex<<case "vaginal_virginity">>your vaginal virginity<<case "anal">>anal sex<<case "anal_virginity">>your anal virginity<<default>>the agreed service<</switch>> for an additional <<printmoney $combatHaggleLast.amount>>.</p>
<</if>>
<</widget>>

::Combat Haggle
<<if $combatHaggle is undefined>><<set $combatHaggle to {status: "open", pauseNow: false, returnPassage: "", result: "", offerId: "", amount: 0, target: 0, proposal: {}}>><</if>><<set _link to true>>
<div id="hagglePanel" class="combat-haggle-panel"><h2>Make it worth his while</h2>
<<if $combatHaggle.status is "open">>
<p>He is interested. Now decide what your attention is worth.</p>
<div style="display:flex;gap:2em;align-items:flex-start;flex-wrap:wrap;"><div style="min-width:18em;flex:1;"><strong>Your offer</strong><br>
<<set _haggleNpc to $NPCList[$combatHaggle.target]>><<set _mouthFree to [$mouthuse,0,"free"].includes($mouthuse)>><<set _genitals to ((_haggleNpc.penis isnot "none" or _haggleNpc.vagina isnot "none") and _haggleNpc.location.genitals isnot "head")>>
<<if _mouthFree and _genitals>><label><<radiobutton "$combatHaggle.offerId" "oral">> Offer your mouth</label><br><<if $player.virginity.oral is true>><label><<radiobutton "$combatHaggle.offerId" "oral_virginity">> Give him your oral virginity</label><br><</if>><</if>>
<<if ($player.penisExist or playerHasStrapon()) and $penilechastity is 0 and $penisstate isnot "penetrated" and (_haggleNpc.vagina isnot "none" or _haggleNpc.location.anus isnot "none")>><label><<radiobutton "$combatHaggle.offerId" "penile">> Offer your cock</label><br><<if $player.virginity.penile is true>><label><<radiobutton "$combatHaggle.offerId" "penile_virginity">> Give him your penile virginity</label><br><</if>><</if>>
<<if $player.vaginaExist and $vaginalchastity is 0 and $vaginastate isnot "penetrated" and _haggleNpc.penis isnot "none">><label><<radiobutton "$combatHaggle.offerId" "vaginal">> Offer your pussy</label><br><<if $player.virginity.vaginal is true>><label><<radiobutton "$combatHaggle.offerId" "vaginal_virginity">> Give him your vaginal virginity</label><br><</if>><</if>>
<<if $analchastity is 0 and $anusstate isnot "penetrated" and _haggleNpc.penis isnot "none">><label><<radiobutton "$combatHaggle.offerId" "anal">> Offer your ass</label><br><<if $player.virginity.anal is true>><label><<radiobutton "$combatHaggle.offerId" "anal_virginity">> Give him your anal virginity</label><br><</if>><</if>>
<<if $combatHaggle.offerId is "">><span class="yellow">Choose what you will offer.</span><<else>><span class="green">Selected: <<switch $combatHaggle.offerId>><<case "oral">>your mouth<<case "oral_virginity">>your oral virginity<<case "penile">>your cock<<case "penile_virginity">>your penile virginity<<case "vaginal">>your pussy<<case "vaginal_virginity">>your vaginal virginity<<case "anal">>your ass<<case "anal_virginity">>your anal virginity<<default>>your body<</switch>></span><</if>></div>
<div style="min-width:12em;flex:1;"><strong>His payment</strong><br><label><<radiobutton "$combatHaggle.amount" 2500>> £25</label><br><label><<radiobutton "$combatHaggle.amount" 5000>> £50</label><br><label><<radiobutton "$combatHaggle.amount" 7500>> £75</label><br><label><<radiobutton "$combatHaggle.amount" 10000>> £100</label><br><label><<radiobutton "$combatHaggle.amount" 15000>> £150</label><br><<if $combatHaggle.amount gt 0>><span class="green">Selected payment: <<printmoney $combatHaggle.amount>></span><<else>><span class="yellow">Choose a payment.</span><</if>></div></div><br>
<<link "Submit proposal">><<if $combatHaggle.offerId is "" or $combatHaggle.amount lte 0>><span class="red">Choose one offer and one amount first.</span><<else>><<set $combatHaggleMade to true>><<set $combatHaggle.proposal to {offer:$combatHaggle.offerId,amount:$combatHaggle.amount,target:$combatHaggle.target}>><<set $combatHaggle.result to ($enemyanger lt 50 ? "accepted" : "declined")>><<if $combatHaggle.result is "accepted">><<set $tip += $combatHaggle.amount>><<set $combatHaggleLast to {offer:$combatHaggle.offerId,amount:$combatHaggle.amount}>><</if>><<set $combatHaggle.status to "resolved">><<replace "#hagglePanel">><<include "Combat Haggle">><</replace>><</if>><</link>>
<<if $combatHaggle.returnPassage isnot "" and Story.has($combatHaggle.returnPassage)>><<link "Cancel">><<set _returnPassage to $combatHaggle.returnPassage>><<set $combatHaggle.pauseNow to false>><<set $combatHaggle.status to "idle">><<unset $nextPassage>><<set $mouthaction to 0>><<set $mouthactiondefault to "rest">><<run Engine.play(_returnPassage)>><</link>><</if>>
<<elseif $combatHaggle.status is "resolved">><<if $combatHaggle.result is "accepted">><p><span class="green">The NPC accepts your proposal.</span></p><<else>><p><span class="red">The NPC declines your proposal.</span></p><</if>><p>This placeholder response performs no payment or sexual action.</p><<if $combatHaggle.returnPassage isnot "" and Story.has($combatHaggle.returnPassage)>><<set $nextPassage to $combatHaggle.returnPassage>><<link "Return to combat">><<set _returnPassage to $combatHaggle.returnPassage>><<set $combatHaggle.pauseNow to false>><<set $combatHaggle.status to "idle">><<unset $nextPassage>><<set $mouthaction to 0>><<set $mouthactiondefault to "rest">><<run Engine.play(_returnPassage)>><</link>><<else>><<dialog "Haggle unavailable">>The original combat passage could not be restored safely.<</dialog>><</if>><</if>></div>
