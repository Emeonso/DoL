::Combat Haggle
<<if $combatHaggle is undefined>><<set $combatHaggle to {status: "open", pauseNow: false, returnPassage: "", result: "", offerId: "", amount: 0, target: 0, proposal: {}}>><</if>><<set _link to true>>
<div id="hagglePanel" class="combat-haggle-panel"><h2>Haggle</h2>
<<if $combatHaggle.status is "open">>
<p>Choose an offer and an amount to propose.</p>
<div style="display:flex;gap:2em;align-items:flex-start;flex-wrap:wrap;"><div style="min-width:18em;flex:1;"><strong>Offer</strong><br>
<<set _haggleNpc to $NPCList[$combatHaggle.target]>><<set _mouthFree to [$mouthuse,0,"free"].includes($mouthuse)>><<set _genitals to ((_haggleNpc.penis isnot "none" or _haggleNpc.vagina isnot "none") and _haggleNpc.location.genitals isnot "head")>>
<<if _mouthFree and _genitals>><label><<radiobutton "$combatHaggle.offerId" "oral">> Offer oral sex</label><br><<if $player.virginity.oral is true>><label><<radiobutton "$combatHaggle.offerId" "oral_virginity">> Offer your oral virginity</label><br><</if>><</if>>
<<if ($player.penisExist or playerHasStrapon()) and $penilechastity is 0 and $penisstate isnot "penetrated" and (_haggleNpc.vagina isnot "none" or _haggleNpc.location.anus isnot "none")>><label><<radiobutton "$combatHaggle.offerId" "penile">> Offer penile sex</label><br><<if $player.virginity.penile is true>><label><<radiobutton "$combatHaggle.offerId" "penile_virginity">> Offer your penile virginity</label><br><</if>><</if>>
<<if $player.vaginaExist and $vaginalchastity is 0 and $vaginastate isnot "penetrated" and _haggleNpc.penis isnot "none">><label><<radiobutton "$combatHaggle.offerId" "vaginal">> Offer vaginal sex</label><br><<if $player.virginity.vaginal is true>><label><<radiobutton "$combatHaggle.offerId" "vaginal_virginity">> Offer your vaginal virginity</label><br><</if>><</if>>
<<if $analchastity is 0 and $anusstate isnot "penetrated" and _haggleNpc.penis isnot "none">><label><<radiobutton "$combatHaggle.offerId" "anal">> Offer anal sex</label><br><<if $player.virginity.anal is true>><label><<radiobutton "$combatHaggle.offerId" "anal_virginity">> Offer your anal virginity</label><br><</if>><</if>>
<<if $combatHaggle.offerId is "">><span class="yellow">Select one offer.</span><<else>>Selected: <<print $combatHaggle.offerId>><</if>></div>
<div style="min-width:12em;flex:1;"><strong>Money</strong><br><label><<radiobutton "$combatHaggle.amount" 2500>> Â£25</label><br><label><<radiobutton "$combatHaggle.amount" 5000>> Â£50</label><br><label><<radiobutton "$combatHaggle.amount" 7500>> Â£75</label><br><label><<radiobutton "$combatHaggle.amount" 10000>> Â£100</label><br><label><<radiobutton "$combatHaggle.amount" 15000>> Â£150</label><br><<if $combatHaggle.amount gt 0>>Selected: <<printmoney $combatHaggle.amount>><<else>><span class="yellow">Select an amount.</span><</if>></div></div><br>
<<link "Submit proposal">><<if $combatHaggle.offerId is "" or $combatHaggle.amount lte 0>><span class="red">Choose one offer and one amount first.</span><<else>><<set $combatHaggle.proposal to {offer:$combatHaggle.offerId,amount:$combatHaggle.amount,target:$combatHaggle.target}>><<set $combatHaggle.result to ($enemyanger lt 50 ? "accepted" : "declined")>><<set $combatHaggle.status to "resolved">><<replace "#hagglePanel">><<include "Combat Haggle">><</replace>><</if>><</link>>
<<if $combatHaggle.returnPassage isnot "" and Story.has($combatHaggle.returnPassage)>><<link "Cancel">><<set _returnPassage to $combatHaggle.returnPassage>><<set $combatHaggle.pauseNow to false>><<set $combatHaggle.status to "idle">><<unset $nextPassage>><<set $mouthaction to 0>><<set $mouthactiondefault to "rest">><<run Engine.play(_returnPassage)>><</link>><</if>>
<<elseif $combatHaggle.status is "resolved">><<if $combatHaggle.result is "accepted">><p><span class="green">The NPC accepts your proposal.</span></p><<else>><p><span class="red">The NPC declines your proposal.</span></p><</if>><p>This placeholder response performs no payment or sexual action.</p><<if $combatHaggle.returnPassage isnot "" and Story.has($combatHaggle.returnPassage)>><<set $nextPassage to $combatHaggle.returnPassage>><<link "Return to combat">><<set _returnPassage to $combatHaggle.returnPassage>><<set $combatHaggle.pauseNow to false>><<set $combatHaggle.status to "idle">><<unset $nextPassage>><<set $mouthaction to 0>><<set $mouthactiondefault to "rest">><<run Engine.play(_returnPassage)>><</link>><<else>><<dialog "Haggle unavailable">>The original combat passage could not be restored safely.<</dialog>><</if>><</if>></div>
