:: Widgets Wardrobe [widget]
<<widget "wardrobewear">>
	<!-- Note: Don't use $_ in this widget, because this widget gets <<replace>>'d into the passage body -->
	<<if $wardrobes[$wardrobe_location] is undefined>>
		<span class="red">A wardrobe error occurred, please report. The default wardrobe will be shown in place of the intended wardrobe.</span>
		<br>
		<!--$wardrobe_location should always point to a specific wardrobe inside of $wardrobes-->
		wardrobe_location: <<print $wardrobe_location>>
		<br>
		passage: <<print $passage>>
		<br><br>
		<<wardrobeSelection true>>
	<</if>>
	<<set _selectedWardrobe to selectWardrobe()>>
	<<wardrobeSanityCheck>>
	<<if $clothingShop.stolenClothes gt 0>>
		<<set $clothingShop.stolenClothes to 0>>
		<span class="gold">You place the clothes you recently stole from the shop in your wardrobe.</span>
		<br>
	<</if>>
	<<if $adultShop isnot undefined and $adultShop.stolenClothes gt 0>>
		<<set $adultShop.stolenClothes to 0>>
		<span class="gold">You place the clothes you recently stole from the adult shop in your wardrobe.</span>
		<br>
	<</if>>
	<<if _wearAction is "strip">>
		You remove your clothing.
		<br><br>
		<<if $worn.under_lower.type.includes("strap-on")>>
			<<undressKeepSlot $wardrobe_location "under_lower">>
		<<else>>
			<<undress $wardrobe_location>>
		<</if>>
	<</if>>
	<<wearoutfit>>
	<<if $randomWear>>
		<<randomWear>>
	<</if>>
	<<set _equip to ["over_upper", "over_lower", "upper", "lower", "under_upper", "under_lower", "over_head", "head", "face", "neck", "hands", "handheld", "legs", "feet", "genitals"]>>
	<<set _slimePrevent to ["upper", "lower", "under_upper", "under_lower"]>>
	<<set _towelCheck to ["upper", "lower"]>>
	<<set _equipSkip to {"over_upper":false, "over_lower":false, "upper":false, "lower":false, "under_upper":false, "under_lower":false, "over_head":false, "head":false, "face":false, "neck":false, "hands":false, "handheld":false, "legs":false, "feet":false, "genitals":false}>>
	<<set _eIndextemNames to []>>
	<<for _slot range _equip>>
		<<unset _outfitPieceIds>>
		<<unset _item>>
		<<if _equipSkip[_slot] is true>>
			<<continue>>
		<</if>>
		<<if !Object.keys($worn).includes(_slot)>>
			<<continue>>
		<<else>>
			<<set _wearId to V["wear_"+_slot]>>
		<</if>>
		<<if _wearId is "none">>
			<<continue>>
		<</if>>
		<<if $wardrobeOption is "wear" or ["strip","towel","large_towel"].includes(_wearId)>>
			/*Checks for cursed equip*/
			<<unset _cursedPrevent>>
			<<set _wornOutfitPrimary to $worn[_slot].outfitPrimary>>
			<<if $worn[_slot].cursed is 1>>
				You try to remove the <<print $worn[_slot].name>>, but fail. <<cursedtext $worn[_slot].name>>
				<br>
				<<set _cursedPrevent to true>>
			<</if>>
			<<if _wornOutfitPrimary isnot undefined>>
				<<for $_outfitPieceSlot, $_outfitPieceName range _wornOutfitPrimary>>
					<<if $worn[$_outfitPieceSlot].cursed is 1 and _cursedPrevent isnot true>>
						<<capture $_outfitPieceSlot>>
							<<cursedtext $worn[$_outfitPieceSlot].name>>
						<</capture>>
						<<set _cursedPrevent to true>>
					<</if>>
				<</for>>
			<</if>>
			<<if _cursedPrevent is true>>
				<<continue>>
			<</if>>
			/* Strip strap-on */
			<<if $worn[_slot].type.includes("strap-on")>>
				<<set _strap to $player.inventory.sextoys[$worn[_slot].name].find(toy => toy.worn)>>
				<<set _strap.worn to false>>
				You remove your <<= $worn[_slot].name>>.
				<<set $worn[_slot] to clone(setup.clothes[_slot][0])>>
			<</if>>
			/*Strips equip and puts it in the wardrobe*/
			<<if _wearId is "strip" and $worn[_slot].name isnot "naked">>
				You remove the <<print $worn[_slot].name>>.
				<<generalUndress $wardrobe_location _slot>>
				<br>
				<<if _wornOutfitPrimary isnot undefined>>
					<<for $_outfitPieceSlot, $_outfitPieceName range _wornOutfitPrimary>>
						<<if $_outfitPieceName isnot "broken" and $_outfitPieceName isnot "split" and $worn[$_outfitPieceSlot].name isnot "naked">>
							You remove the <<print $worn[$_outfitPieceSlot].name>>.
							<<generalUndress $wardrobe_location $_outfitPieceSlot>>
						<</if>>
					<</for>>
				<</if>>
				<<continue>>
			<</if>>
			<<unset _wornOutfitPrimary>>
			/*Strips equip, puts it in the wardrobe and equips a towl*/
			<<if _wearId is "towel" and _towelCheck.includes(_slot)>>
				<<generalUndress $wardrobe_location _slot>>
				<<set $worn[_slot] to clone(setup.clothes[_slot][3])>><<set $worn[_slot].colour to clone($worn[_slot].colour_options.random())>>
				<<if _slot is "upper">>
					You tie a towel around your chest.
				<<else>>
					You tie a towel around your waist.
				<</if>>
				<br><br>
				<<continue>>
			<</if>>
			<<if _wearId is "large_towel" and _slot is "upper">>
				<<generalUndress $wardrobe_location "upper">><<generalUndress $wardrobe_location "lower">>
				<<set $worn.upper to clone(setup.clothes.upper[14])>><<set $worn.upper.colour to clone($worn.upper.colour_options.random())>>
				<<set $worn.lower to clone(setup.clothes.lower[15])>><<set $worn.lower.colour to clone($worn.upper.colour)>>
				You tie a large towel around your chest.
				<br><br>
				<<continue>>
			<</if>>
		<</if>>
		/*Find the item to equip*/
		<<if _wearId gte 0>>
			<<set _item to _selectedWardrobe[_slot][_wearId]>>
		<<else>>
			<<continue>>
		<</if>>
		/*Prevent equip when preggy*/
		<<if playerBellySize() gte 12 and _item.type.includes("constricting") and $wardrobeOption is "wear">>
			<<if _item.type.includes("chest_bind")>>
				<span class="red">Your pregnant body is too sensitive to wear your _item.name.</span>
			<<else>>
				<span class="red">Your <<bellyDescription "pc">> is too large to wear your _item.name.</span>
			<</if>>
			<br>
			<<continue>>
		<</if>>
		/*Prevent equip when the ear slime doesn't allow it*/
		<<if _slimePrevent.includes(_slot) and $wardrobeOption is "wear" and $earSlime.corruption gte 10 and $hypnosis_traits?.silence isnot 1>>
			<<if $earSlime.forcedCommando isnot undefined and (_slot is "under_lower" or (_item.outfitPrimary and _item.outfitPrimary.under_lower and !["broken","split"].includes(_item.outfitPrimary.under_lower)))>>
				<<if _item.type.includes("naked") or (_earSlimeEnableSwimwear and _item.type.includes("swim")) or (_earSlimeEnableDancewear and _item.type.includes("dance"))>>
				<<elseif $earSlime.forcedCommando gte 0>>
					<span class="red">You are unable to equip your _item.name, as the slime in your ear is forcing you to go commando.</span>
					<br>
					<<continue>>
				<<else>>
					<<run delete $earSlime.forcedCommando>>
				<</if>>
			<<elseif _item.reveal lt earSlimeCorruptionClothes() and (["prison", "asylum"].includes($location) or !_allowSchoolClothes) and !_item.type.includesAny("event")>>
				<span class="red">You were unable to equip your _item.name as the slime in your ear did not permit it.</span>
				<br>
				<<continue>>
			<<elseif $earSlime.forcedDressing and _item.gender isnot $earSlime.forcedDressing.type and _item.gender isnot "n" and !_item.type.includesAny("event")>>
				<<if $earSlime.forcedDressing.days gt 0>>
					<span class="red">You are unable to equip your _item.name, as the slime in your ear is only permitting more <<print $earSlime.forcedDressing.type is "f" ? "feminine" : "masculine">> clothing.</span>
					<br>
					<<continue>>
				<<else>>
					<<run delete $earSlime.forcedDressing>>
				<</if>>
			<</if>>
		<</if>>
		/*Finds any outfit pieces and records the Ids*/
		<<set _outfitPieceIds to {}>>
		<<if _item.outfitPrimary isnot undefined>>
			<<for $_outfitPieceSlot, $_outfitPieceName range _item.outfitPrimary>>
				<<if $_outfitPieceName is "broken" or $_outfitPieceName is "split">>
					<<continue>>
				<</if>>
				<<for $_outfitPieceId, $_wardrobeItem range _selectedWardrobe[$_outfitPieceSlot]>>
					<<if $_wardrobeItem.name isnot $_outfitPieceName>>
						<<continue>>
					<</if>>
					<<if _item.colour isnot $_wardrobeItem.colour or ($_wardrobeItem.accessory isnot 0 and _item.accessory_colour isnot $_wardrobeItem.accessory_colour) or ($_wardrobeItem.pattern and _item.pattern and $_wardrobeItem.pattern isnot 0 and _item.pattern isnot $_wardrobeItem.pattern)>>
						<<continue>>
					<</if>>
					<<if $_wardrobeItem.outfitSecondary[1] isnot _item.name>>
						<<continue>>
					<</if>>
					<<set _matched to 0>>
					<<if $_wardrobeItem.colour isnot "custom" or (_item.colourCustom isnot undefined and _item.colourCustom is $_wardrobeItem.colourCustom)>>
						<<set _matched++>>
					<</if>>
					<<if $_wardrobeItem.accessory is 0 or $_wardrobeItem.accessory_colour isnot "custom" or (_item.accessory_colourCustom isnot undefined and _item.accessory_colourCustom is $_wardrobeItem.accessory_colourCustom)>>
						<<set _matched++>>
					<</if>>
					<<if _matched is 2>>
						<<set _outfitPieceIds[$_outfitPieceSlot] to $_outfitPieceId>>
						<<set _equipSkip[$_outfitPieceSlot] to true>>
						<<break>>
					<</if>>
				<</for>>
			<</for>>
		<</if>>
		<<if $wardrobeOption is "delete">>
			/*Delete the relating items*/
			<<for $_outfitSlot, $_outfitId range _outfitPieceIds>>
				<<set _selectedWardrobe[$_outfitSlot].deleteAt($_outfitId)>>
			<</for>>
			You discard the <<print _item.name>>.
			<<set _selectedWardrobe[_slot].deleteAt(_wearId)>>
			<br>
		<<elseif $wardrobeOption is "repair">>
			<<set _item.integrity to clothingData(_slot,_item,'integrity_max')>>
			<<set $_timeSpent to 5>>
			/*Repair the relating items*/
			<<for $_outfitSlot, $_outfitId range _outfitPieceIds>>
				<<set _selectedWardrobe[$_outfitSlot][$_outfitId].integrity to clothingData($_outfitSlot,_selectedWardrobe[$_outfitSlot][$_outfitId],'integrity_max')>>
				<<set $_timeSpent += 5>>
			<</for>>
			<<pass $_timeSpent>>
			You repair the <<print _item.name>>.
			<br>
		<<elseif $wardrobeOption is "separateOutfits" and Object.values(_outfitPieceIds).length gt 0>>
			<<for $_outfitSlot, $_outfitId range _outfitPieceIds>>
				<<set $_secondaryItem to _selectedWardrobe[$_outfitSlot][$_outfitId]>>
				<<set $_secondaryItem.outfitSecondary[1] to "split">>
				<<set $_secondaryItem.one_piece to "split">>

				/* Inherit primary's accessory_colour/pattern for repairs (i.e. overall buttons or hanfu sash) */
				<<inheritOutfitAttributes $_secondaryItem _item>>
				<<set _item.outfitPrimary[$_outfitSlot] to "split">>
			<</for>>
			<<set _item.one_piece to "split">>
			You cut up the <<print _item.name>>.
			<<pass 10>>
			<br>
		<<elseif $wardrobeOption is "transfer" and _wardrobeTransfer isnot $wardrobe_location and _wardrobeTransfer isnot undefined>>
			<<unset _slotsFull>>
			/*Set the target wardrobe*/
			<<set _wardrobeTransferObject to selectWardrobe(_wardrobeTransfer, "return")>>
			/*Make sure there is enough space*/
			<<if _wardrobeTransferObject[_slot].length gt _wardrobeTransferObject.space>>
				<<set _slotsFull to true>>
			<</if>>
			<<for $_outfitSlot, $_outfitId range _outfitPieceIds>>
				<<if _wardrobeTransferObject[$_outfitSlot].length gt _wardrobeTransferObject.space>>
					<<set _slotsFull to true>>
				<</if>>
			<</for>>

			<<if !_slotsFull>>
				You transferred the <<print _item.name>> to the <<print $wardrobes[_wardrobeTransfer].name>> storage.
				/*Transfer everything*/
				<<run transferClothing(_slot,_wearId,_wardrobeTransfer)>>
				<<for $_outfitSlot, $_outfitId range _outfitPieceIds>>
					<<run transferClothing($_outfitSlot,$_outfitId,_wardrobeTransfer)>>
				<</for>>
			<<else>>
				You were unable to transfer the <<print _item.name>> to the <<print $wardrobes[_wardrobeTransfer].name>> wardrobe due to lack of space there.
			<</if>>
		<<elseif $wardrobeOption is "wear">>
			/*Equip the relating items*/
			<<generalUndress $wardrobe_location _slot>>
			<<for $_outfitSlot, $_outfitId range _outfitPieceIds>>
				<<generalUndress $wardrobe_location $_outfitSlot>>
				<<set $worn[$_outfitSlot] to clone(_selectedWardrobe[$_outfitSlot][$_outfitId])>>
				<<set $worn[$_outfitSlot].lastTaken to $wardrobe_location>>
				<<set _selectedWardrobe[$_outfitSlot].deleteAt($_outfitId)>>
				<<run resetClothingState($_outfitSlot)>>
			<</for>>
			<<set $worn[_slot] to clone(_item)>>
			<<set $worn[_slot].lastTaken to clone($wardrobe_location)>>
			<<run resetClothingState(_slot)>>
			<<set _eIndextemNames.push(_item.name)>>
			<<set _selectedWardrobe[_slot].deleteAt(_wearId)>>
		<</if>>
	<</for>>
	<<if $worn.under_lower.type.includes("naked")>>
		<<set $worn.under_lower.exposedType to "notWorn">>
	<</if>>
	<<if $wardrobeOption is "wear" and _eIndextemNames.length gte 1>>
		You put on the <<print formatList(_eIndextemNames)>>.
	<</if>>
	<<if _wearAction is "dry">>
		<<dry>>
		You wring out your clothes.
		<<effectswater "liquid">>
		<br><br>
	<</if>>
	<<unset _wearAction>>
	<<set $wear_over_upper to "none">>
	<<set $wear_over_lower to "none">>
	<<set $wear_upper to "none">>
	<<set $wear_lower to "none">>
	<<set $wear_under_upper to "none">>
	<<set $wear_under_lower to "none">>
	<<set $wear_over_head to "none">>
	<<set $wear_head to "none">>
	<<set $wear_face to "none">>
	<<set $wear_neck to "none">>
	<<set $wear_hands to "none">>
	<<set $wear_handheld to "none">>
	<<set $wear_legs to "none">>
	<<set $wear_feet to "none">>
	<<set $wear_genitals to "none">>
	<<set $wear_outfit to "none">>
	<<exposure>>
<</widget>>

<<widget "loadWardrobeOptions">>
	<div onclick="event.stopPropagation()">
		<div class="legend-caption bold gold">Settings</div>
		<div>
			<label>
				<<checkbox "$wardrobeDefaults.showTraits" false true autocheck>>
				Show clothing trait icons.
			</label>
		</div>
		<div>
			<label>
				<<checkbox "$wardrobeDefaults.extraInfo" false true autocheck>>
				Show 'Extra Info' by default.
			</label>
		</div>
		<div>
			<<link "Configure random">><<toggleclass "#randomClothingConfigure" "hidden">><</link>>
		</div>
		<div id="randomClothingConfigure" class="hidden">
			<<if $randomEquipConfigure is undefined>>
				<<set $randomEquipConfigure to {face: true, feet: true, head: true, hands: true, legs: true, lower: true, neck: true, under_lower: true, under_upper: true, upper: true}>>
			<</if>>
			<<for _slot range Object.keys($randomEquipConfigure)>>
				<<capture _slot>>
					<label><<checkbox "$randomEquipConfigure[_slot]" false true autocheck>> <<print _slot.replace("_"," ")>></label><br>
				<</capture>>
			<</for>>
		</div>
		<<if $options.images and ($uncomfortable.underwear or $uncomfortable.nude)>>
			<div>
				<span class="gold bold">Self-covering:</span>
				<span id="wardrobe-cover" @class="$dontHide ? '' : 'hidden'">
					<<link "Cover yourself">>
						<<dontHideRevert>>
						<<toggleclass "#wardrobe-cover" "hidden">>
						<<toggleclass "#wardrobe-dontCover" "hidden">>
						<<updatesidebarimg>>
					<</link>>
				</span>
				<span id="wardrobe-dontCover" @class="$dontHide ? 'hidden' : ''">
					<<link "Don't cover yourself">>
						<<dontHideForNow>>
						<<toggleclass "#wardrobe-cover" "hidden">>
						<<toggleclass "#wardrobe-dontCover" "hidden">>
						<<updatesidebarimg>>
					<</link>>
				</span>
			</div>
		<</if>>
		<<link [[Update wardrobe|$passage]]>><</link>>
	</div>
<</widget>>

<<widget "wardrobeToggleOptions">>
	<<replace '#shop-options'>><<loadWardrobeOptions>><</replace>>
	<<toggleclass '#shop-options' 'hidden'>>
<</widget>>


<<widget "wardrobe">>
	<<set _inWardrobe to true>>
	<div id="action-popup">Don't look here.</div>
	<<unset $tempDisable>>
<<wardrobePreviewSnapshot "wardrobe">>

	<!-- Options -->
	<div id="wardrobe-options-div" class="main-shop-div">
		<div class="wardrobe-options-button no-numberify">
			<<if $options.images is 1>>
				<<iconUi "options.png">>
			<<else>>
				Opt.
			<</if>>
			<<link " ">>
				<<wardrobeToggleOptions>>
			<</link>>
		</div>
		<div id="shop-options" class="wardrobe-options no-numberify hidden" onclick="$(this).addClass('hidden')">
		</div>
	</div>

	<hr>
<div class="wardrobe-top-layout">
  <section class="wardrobe-paperdoll-panel" aria-label="Paper doll preview">
    <div class="wardrobe-paperdoll-controls no-numberify">
      <<link "Hair">><<replace "#wardrobeRightPanel">><<wardrobeStylePanel "hair">><</replace>><<numberify "#wardrobeRightPanel">><<run setTimeout(() => window.wardrobeSyncStylePanelHeight(), 0)>><</link>>
      <<link "Makeup">><<replace "#wardrobeRightPanel">><<wardrobeStylePanel "makeup">><</replace>><<numberify "#wardrobeRightPanel">><<run setTimeout(() => window.wardrobeSyncStylePanelHeight(), 0)>><</link>>
    </div>
    <div id="wardrobePaperDoll"><<wardrobePaperDoll>></div>
    <div class="wardrobe-apply-row no-numberify" id="wardrobeApply"><<wardrobeApplyChanges>></div>
  </section>
  <aside class="wardrobe-summary-panel">
    <div id="wardrobeRightPanel"><<wardrobeRightSummary>></div>
  </aside>
</div>

<hr><div id="clotheson"><<wardrobePreviewRenderClothesOn>></div> /*Fixes perma pulled aside clothes introduced by 0.2.3.0 bug.*/
	<<if $upperwet gte 1 or $lowerwet gte 1 or $underlowerwet gte 1 or $underupperwet gte 1>>
		<div class="wardrobe-dry">
		<<link "Dry your clothes">>
			<<set _wearAction to "dry">>
			<<updatewardrobe>>
			<<if $upperwet lt 1 and $lowerwet lt 1 and $underlowerwet lt 1 and $underupperwet lt 1>>
				<<remove ".wardrobe-dry">>
			<</if>>
		<</link>>
		<br>
		</div>
	<</if>>
	<div class="wardrobe-action">
		<<link "Strip all">>
			<<wardrobePreviewStrip>>
		<</link>>
	</div> |
	<div class="wardrobe-action">
		<<link "Wear random clothes">>
			<<wardrobePreviewRandom>>
		<</link>>
	</div>
	<br><br>

	<<if $location is "home" or $location is "town">>
		<<if $tailorMonthlyService is "repair">>
			__Wardrobe Repair Crate__
			<br>
			There is a small crate ready for sending clothes to be repaired.
			<br>
			<<link [[Add damaged items and send|Wardrobe Repair Crate]]>>
				<<set $wardrobeReturnLink to $passage>>
				<<set $crateContents to "damaged">>
			<</link>>
			<br>
			<<link [[Add outfits and send|Wardrobe Repair Crate]]>>
				<<set $wardrobeReturnLink to $passage>>
				<<set $crateContents to "outfits">>
			<</link>>
			<br>
			<<link [[Add all items and send|Wardrobe Repair Crate]]>>
				<<set $wardrobeReturnLink to $passage>>
				<<set $crateContents to "all">>
			<</link>>
			<br><br>
			<<link [[Cancel the request|$passage]]>><<set $tailorMonthlyService to 1>><</link>>
			<br><br>
		<<elseif $tailorMonthlyService is "discard">>
			__Wardrobe Sale Crate__
			There is a small crate ready for sending clothes to be sold.
			<br>
			<<link [[Add outfits and send|Wardrobe Sale Crate]]>>
				<<set $wardrobeReturnLink to $passage>>
				<<set $crateContents to "outfits">>
			<</link>>
			<br>
			<<link [[Add all items and send|Wardrobe Sale Crate]]>>
				<<set $wardrobeReturnLink to $passage>>
				<<set $crateContents to "all">>
			<</link>>
			<br><br>
			<<link [[Cancel the request|$passage]]>><<set $tailorMonthlyService to 1>><</link>>
			<br><br>
		<</if>>
		<<if $wardrobeRepair is undefined>>
		<<elseif $wardrobeRepair.timeLeft is 0>>
			The clothes sent to the tailor have been repaired and added back into your wardrobe.
			<<wardrobeGetRepairedClothes>>
			<br><br>
		<</if>>
	<</if>>

	__Clothing sets__
	<br>
	<div id="listoutfits"><<listoutfits>></div>

	<hr>
	__Clothing__
	<br>

	<<dynamic "wardrobeContents" "wardrobeList">>

	<br>


	<<set $upperoff to 0>>
	<<set $loweroff to 0>>
	<<set $underloweroff to 0>>
	<<set $underupperoff to 0>>
	<<exposure>>

	<!-- Code responsible for brief highlighting of links in wardrobe when you click them -->
  <<run $(document).off('mousedown.dolWardrobeHighlight', '.wardrobe-action a').on('mousedown.dolWardrobeHighlight', '.wardrobe-action a', (e) => {
		let target = $(e.currentTarget).parent();
		target.addClass('notransition action-flash');
		setTimeout(() => { target.removeClass('notransition action-flash') }, 100);
	})>>
<</widget>>
<<widget "wardrobeRightSummary">><div class="wardrobe-warmth-header"><span>Warmth:</span><span class="wardrobe-outside-temp teal"><<print Weather.toSelectedString(Weather.temperature, 0)>></span></div><<wardrobePreviewRenderSummary>><</widget>>
<<widget "attractivenessscale">>
	<<calculateallure>>
	<div id="attractivenessScale" class="warmth-scale-container attractiveness-scale" aria-label="Attractiveness rating scale">
		<div class="warmth-scale-div attractiveness-scale-div" role="img" aria-label="Attractiveness rating bands">
			<span class="attractiveness-scale-segment attractiveness-scale-segment-f" aria-label="F rating"></span>
			<span class="attractiveness-scale-segment attractiveness-scale-segment-d" aria-label="D rating"></span>
			<span class="attractiveness-scale-segment attractiveness-scale-segment-c" aria-label="C rating"></span>
			<span class="attractiveness-scale-segment attractiveness-scale-segment-b" aria-label="B rating"></span>
			<span class="attractiveness-scale-segment attractiveness-scale-segment-a" aria-label="A rating"></span>
			<span class="attractiveness-scale-segment attractiveness-scale-segment-s" aria-label="S rating"></span>
		</div>
		<img id="attractivenessIndicator" class="warmth-indicator" src="img/ui/clothes/warmth-indicator.png" />
	</div>
	<<updateattractivenessscale $attractiveness>>
<</widget>>

<<widget "attractiveness_description">>
	<<set _attractivenessRating to window.getAttractivenessRating($attractiveness)>>
	<<set _attractivenessFactors to window.getAttractivenessContributingFactors()>>
	<div class="attractiveness-overview">
		<div class="attractiveness-rating-line">Rating: <span @class="'attractiveness-grade attractiveness-grade-' + _attractivenessRating.grade.toLowerCase()"><<print _attractivenessRating.grade>></span></div>
	</div>
	<div id="attractiveness-factors" class="attractiveness-factors">
		<div class="attractiveness-factors-title">Contributing Factors:</div>
		<ul>
			<<for _factor range _attractivenessFactors>>
			<li @class="_factor.positive ? 'attractiveness-factor-positive' : 'attractiveness-factor-negative'"><span><<print _factor.label>></span><span class="attractiveness-factor-marker"><<print _factor.marker>></span></li>
			<</for>>
		</ul>
	</div>
<</widget>>

<<widget "updateattractivenessdescription">>
	<<if $('#attractiveness-description')[0]>>
		<<replace '#attractiveness-description'>><<attractiveness_description>><</replace>>
	<</if>>
<</widget>>

<<widget "wardrobeRefreshPaperDoll">>
	<<if $('#wardrobePaperDoll')[0]>>
		<<replace '#wardrobePaperDoll'>>
	<<wardrobePaperDoll>>
	<</replace>>
	<</if>>
<</widget>>

<<widget "wardrobeStylePanel">>
<<if _args[0] is "hair">>
  <<wardrobeHairEnsureState>>
  <<set $wardrobePreview.hairUi.section to "browse">>
  <<set $wardrobePreview.hairUi.category to null>>
<</if>>
<div class="wardrobe-style-panel"><div class="wardrobe-style-panel-header no-numberify"><<link "Back to wardrobe">>
	<<replace "#wardrobeRightPanel">>
	<<wardrobeRightSummary>>
	<</replace>>
	<<numberify "#wardrobeRightPanel">>
	<<run setTimeout(() => window.wardrobeSyncStylePanelHeight(), 0)>>
	<</link>>
	</div><div class="wardrobe-style-mirror"><<wardrobePreviewRenderStylePanel _args[0]>>
	</div></div>
<</widget>>

<<widget "wardrobeClothingEnsureState">>
  <<if $wardrobePreview is undefined>><<wardrobePreviewSnapshot>><</if>>
  <<set _clothingSlotList to ["head", "face", "neck", "over_head", "over_upper", "hands", "handheld", "upper", "under_upper", "lower", "under_lower", "genitals", "over_lower", "legs", "feet"]>>
  <<if $wardrobePreview.clothingUi is undefined>><<set $wardrobePreview.clothingUi to {slot:"upper"}>><</if>>
  <<if !_clothingSlotList.includes($wardrobePreview.clothingUi.slot)>><<set $wardrobePreview.clothingUi.slot to "upper">><</if>>
<</widget>>

<<widget "wardrobeClothingOpenSlot">>
  <<wardrobeClothingEnsureState>>
  <<if _args[0]>><<set $wardrobePreview.clothingUi.slot to _args[0]>><</if>>
  <<replace "#wardrobeRightPanel">><<wardrobeStylePanel "clothing">><</replace>>
  <<numberify "#wardrobeRightPanel">>
  <<run setTimeout(() => window.wardrobeSyncStylePanelHeight(), 0)>>
<</widget>>

<<widget "wardrobePreviewSnapshot">>
  <<if $wardrobePreview is undefined or $wardrobePreview.active isnot true or _args[0] is "wardrobe" or _args[0] is true>>
    <<set _previewActive to _args[0] is "wardrobe" or _args[0] is true>>
    <<set _previewLocation to ($wardrobe_location and $wardrobes[$wardrobe_location]) ? $wardrobe_location : "wardrobe">>
    <<set _previewWardrobe to clone(selectWardrobe())>>
    <<set _previewHair to {
      type: $hairtype, fringe: $fringetype, position: $hairposition,
      length: $hairlength, lengthStage: $hairlengthstage,
      fringeLength: $fringelength, fringeLengthStage: $fringelengthstage,
      colour: $haircolour, fringeColour: $hairfringecolour,
      colourGradient: $hairColourGradient, fringeColourGradient: $hairFringeColourGradient,
      colourStyle: $hairColourStyle, fringeColourStyle: $hairFringeColourStyle, ruffledisable: $ruffledisable
    }>>
    <<set _previewCurrent to {
      worn: clone($worn), carried: clone($carried), wardrobe: _previewWardrobe,
      hair: _previewHair, face: {style: $facestyle, variant: $facevariant}, makeup: clone($makeup)
    }>>
    <<set $wardrobePreview to {
      active: _previewActive, location: _previewLocation,
      baseline: clone(_previewCurrent), current: clone(_previewCurrent),
      makeupApplied: clone(_previewCurrent.makeup)
    }>>
  <</if>>
  <<if $wardrobePreview.makeupApplied is undefined>>
	<<set $wardrobePreview.makeupApplied to clone($wardrobePreview.current.makeup)>>
	<</if>>
<</widget>>

<<widget "wardrobePreviewCalculateDiff">>
  <<set $wardrobePreviewTimeCost to ($wardrobePreview and window.wardrobePreviewCalculate) ? window.wardrobePreviewCalculate($wardrobePreview) : 0>>
<</widget>>

<<widget "wardrobePreviewProjectCurrent">>
  <<set _previewProjectionState to clone(V)>>
  <<set $worn to clone($wardrobePreview.current.worn)>>
  <<set $carried to clone($wardrobePreview.current.carried)>>
  <<set $wardrobe_location to $wardrobePreview.location>>
  <<if $wardrobePreview.location is "wardrobe">>
    <<set $wardrobe to clone($wardrobePreview.current.wardrobe)>>
  <<else>>
    <<set $wardrobes[$wardrobePreview.location] to clone($wardrobePreview.current.wardrobe)>>
  <</if>>
  <<set $hairtype to $wardrobePreview.current.hair.type>>
  <<set $fringetype to $wardrobePreview.current.hair.fringe>>
  <<set $hairposition to $wardrobePreview.current.hair.position>>
  <<set $hairlength to $wardrobePreview.current.hair.length>>
  <<set $hairlengthstage to $wardrobePreview.current.hair.lengthStage>>
  <<set $fringelength to $wardrobePreview.current.hair.fringeLength>>
  <<set $fringelengthstage to $wardrobePreview.current.hair.fringeLengthStage>>
  <<set $haircolour to $wardrobePreview.current.hair.colour>>
  <<set $hairfringecolour to $wardrobePreview.current.hair.fringeColour>>
  <<set $hairColourGradient to $wardrobePreview.current.hair.colourGradient>>
  <<set $hairFringeColourGradient to $wardrobePreview.current.hair.fringeColourGradient>>
  <<set $hairColourStyle to $wardrobePreview.current.hair.colourStyle>>
  <<set $hairFringeColourStyle to $wardrobePreview.current.hair.fringeColourStyle>>
  <<set $ruffledisable to $wardrobePreview.current.hair.ruffledisable>>
  <<set $facestyle to $wardrobePreview.current.face.style>>
  <<set $facevariant to $wardrobePreview.current.face.variant>>
  <<set $makeup to clone($wardrobePreview.current.makeup)>>
<</widget>>

<<widget "wardrobePreviewRestoreProjection">>
  <<run Object.keys(V).forEach(key => delete V[key]); Object.assign(V, _previewProjectionState)>>
<</widget>>

<<widget "wardrobePreviewRenderSummary">>
  <<if $wardrobePreview isnot undefined and $wardrobePreview.active is true>>
    <<wardrobePreviewProjectCurrent>>
	<<warmthscale>>
	<<warmth_description>>
	<div class="attractiveness-summary-title"><span>Attractiveness:</span><span class="attractiveness-details-button no-numberify"><<link "Details">><<run $('#attractiveness-factors').toggleClass('attractiveness-factors-open')>><</link>></span></div><<attractivenessscale>>
	<div id="attractiveness-description"><<attractiveness_description>>
	</div><<wardrobePreviewRestoreProjection>>
  <<else>>
    <<warmthscale>>
	<<warmth_description>>
	<div class="attractiveness-summary-title"><span>Attractiveness:</span><span class="attractiveness-details-button no-numberify"><<link "Details">><<run $('#attractiveness-factors').toggleClass('attractiveness-factors-open')>><</link>></span></div><<attractivenessscale>>
	<div id="attractiveness-description"><<attractiveness_description>>
	</div>
  <</if>>
<</widget>>

<<widget "wardrobePreviewRenderClothesOn">>
  <<if $wardrobePreview isnot undefined and $wardrobePreview.active is true>>
	<<wardrobePreviewProjectCurrent>>
	<<clotheson>>
	<<wardrobePreviewRestoreProjection>>
	<<else>>
	<<clotheson>>
	<</if>>
<</widget>>

<<widget "wardrobePreviewSandboxResult">>
  <<set _previewSandboxResult to {
    worn: clone($worn), carried: clone($carried), wardrobe: clone(selectWardrobe()),
    hair: {
      type: $hairtype, fringe: $fringetype, position: $hairposition,
      length: $hairlength, lengthStage: $hairlengthstage,
      fringeLength: $fringelength, fringeLengthStage: $fringelengthstage,
      colour: $haircolour, fringeColour: $hairfringecolour,
      colourGradient: $hairColourGradient, fringeColourGradient: $hairFringeColourGradient,
      colourStyle: $hairColourStyle, fringeColourStyle: $hairFringeColourStyle,
      ruffledisable: $ruffledisable
    }
  }>>
<</widget>>

<<widget "wardrobePreviewEquip">>
  <<if $wardrobePreview isnot undefined and $wardrobePreview.active is true and !window.wardrobeIsComboLowerLocked($wardrobePreview.current.worn, _args[0])>>
    <<set _previewSandboxState to clone(V)>>
    <<wardrobePreviewProjectCurrent>>
    <<set _previewComboPair to {combo:false, source:"none"}>>
    <<if (_args[0] is "upper" or _args[0] is "under_upper") and _args[1] gte 0>>
      <<set _previewComboWardrobe to selectWardrobe()>>
      <<set _previewComboUpper to _previewComboWardrobe[_args[0]][_args[1]]>>
      <<set _previewComboLowerSlot to _args[0] is "under_upper" ? "under_lower" : "lower">>
      <<set _previewComboPair to window.wardrobeFindComboLower(_previewComboUpper, $worn[_previewComboLowerSlot], _previewComboWardrobe[_previewComboLowerSlot], _args[0])>>
    <</if>>
    <<if _previewComboPair.combo and _previewComboPair.source is "missing">>
      <<run Object.keys(V).forEach(key => delete V[key]); Object.assign(V, _previewSandboxState)>>
      <<exit>>
    <</if>>
    <<if _previewComboPair.combo and _previewComboPair.item isnot null>>
      <<run window.wardrobeRepairComboMetadata(_previewComboUpper, _previewComboPair.item, _previewComboPair.lowerName, _args[0])>>
    <</if>>
    <<generalWearFromWardrobe _args[0] _args[1]>>
	<<wardrobePreviewSandboxResult>>
    <<set _previewSandboxPreview to clone($wardrobePreview)>>
	<<set _previewSandboxPreview.current.worn to _previewSandboxResult.worn>>
	<<set _previewSandboxPreview.current.carried to _previewSandboxResult.carried>>
	<<set _previewSandboxPreview.current.wardrobe to _previewSandboxResult.wardrobe>>
	<<set _previewSandboxPreview.current.hair to _previewSandboxResult.hair>>
    <<run Object.keys(V).forEach(key => delete V[key]); Object.assign(V, _previewSandboxState)>>
	<<set $wardrobePreview to _previewSandboxPreview>>
	<<wardrobePreviewRefresh _args[2]>>
  <</if>>
<</widget>>

<<widget "wardrobePreviewRemove">>
  <<if $wardrobePreview isnot undefined and $wardrobePreview.active is true and !window.wardrobeIsComboLowerLocked($wardrobePreview.current.worn, _args[0])>>
    <<set _previewSandboxState to clone(V)>>
    <<wardrobePreviewProjectCurrent>>
    <<generalUndress $wardrobePreview.location _args[0]>>
	<<wardrobePreviewSandboxResult>>
    <<set _previewSandboxPreview to clone($wardrobePreview)>>
	<<set _previewSandboxPreview.current.worn to _previewSandboxResult.worn>>
	<<set _previewSandboxPreview.current.carried to _previewSandboxResult.carried>>
	<<set _previewSandboxPreview.current.wardrobe to _previewSandboxResult.wardrobe>>
	<<set _previewSandboxPreview.current.hair to _previewSandboxResult.hair>>
    <<run Object.keys(V).forEach(key => delete V[key]); Object.assign(V, _previewSandboxState)>>
	<<set $wardrobePreview to _previewSandboxPreview>>
	<<wardrobePreviewRefresh _args[1]>>
  <</if>>
<</widget>>

<<widget "wardrobePreviewStrip">>
  <<if $wardrobePreview isnot undefined and $wardrobePreview.active is true>>
    <<set _previewSandboxState to clone(V)>>
    <<wardrobePreviewProjectCurrent>>
    <<undress "wardrobe">>
	<<wardrobePreviewSandboxResult>>
    <<set _previewSandboxPreview to clone($wardrobePreview)>>
	<<set _previewSandboxPreview.current.worn to _previewSandboxResult.worn>>
	<<set _previewSandboxPreview.current.carried to _previewSandboxResult.carried>>
	<<set _previewSandboxPreview.current.wardrobe to _previewSandboxResult.wardrobe>>
	<<set _previewSandboxPreview.current.hair to _previewSandboxResult.hair>>
    <<run Object.keys(V).forEach(key => delete V[key]); Object.assign(V, _previewSandboxState)>>
	<<set $wardrobePreview to _previewSandboxPreview>>
	<<wardrobePreviewRefresh>>
  <</if>>
<</widget>>

<<widget "wardrobePreviewRandom">>
  <<if $wardrobePreview isnot undefined and $wardrobePreview.active is true>>
    <<set _previewSandboxState to clone(V)>>
    <<wardrobePreviewProjectCurrent>>
    <<set $randomWear to true>>
	<<set $wardrobeOption to "wear">>
	<<wardrobewear>>
	<<wardrobePreviewSandboxResult>>
    <<set _previewSandboxPreview to clone($wardrobePreview)>>
	<<set _previewSandboxPreview.current.worn to _previewSandboxResult.worn>>
	<<set _previewSandboxPreview.current.carried to _previewSandboxResult.carried>>
	<<set _previewSandboxPreview.current.wardrobe to _previewSandboxResult.wardrobe>>
	<<set _previewSandboxPreview.current.hair to _previewSandboxResult.hair>>
    <<run Object.keys(V).forEach(key => delete V[key]); Object.assign(V, _previewSandboxState)>>
	<<set $wardrobePreview to _previewSandboxPreview>>
	<<wardrobePreviewRefresh>>
  <</if>>
<</widget>>

<<widget "wardrobePreviewOutfit">>
  <<if $wardrobePreview isnot undefined and $wardrobePreview.active is true>>
    <<set _previewSandboxState to clone(V)>>
	<<set $_storeLocation to $wardrobePreview.location>>
	<<set $wardrobeOption to "wear">>
	<<set $wear_outfit to _args[0]>>
	<<wardrobePreviewProjectCurrent>>
	<<wearoutfit>>
	<<wardrobePreviewSandboxResult>>
	<<set _previewSandboxPreview to clone($wardrobePreview)>>
	<<set _previewSandboxPreview.current.worn to _previewSandboxResult.worn>>
	<<set _previewSandboxPreview.current.carried to _previewSandboxResult.carried>>
	<<set _previewSandboxPreview.current.wardrobe to _previewSandboxResult.wardrobe>>
	<<set _previewSandboxPreview.current.hair to _previewSandboxResult.hair>>
	<<run Object.keys(V).forEach(key => delete V[key]); Object.assign(V, _previewSandboxState)>>
	<<set $wardrobePreview to _previewSandboxPreview>>
	<<wardrobePreviewRefresh>>
  <</if>>
<</widget>>
<<widget "wardrobePreviewReset">>
  <<set $wardrobePreview.current to clone($wardrobePreview.baseline)>>
	<<set $wardrobePreview.makeupApplied to clone($wardrobePreview.baseline.makeup)>>
	<<wardrobePreviewRefresh>>
<</widget>>

<<widget "wardrobePreviewChangeHair">>
  <<set _previewHair to clone($wardrobePreview.current.hair)>>
	<<set _previewHair[_args[0]] to _args[1]>>
	<<if _args[0] is "type" or _args[0] is "fringe">>
	<<set _previewHair.ruffledisable to "f">>
	<</if>>
	<<set $wardrobePreview.current.hair to _previewHair>>
	<<wardrobePreviewRefresh "hair">>
<</widget>>

<<widget "wardrobePreviewChangeHairSingle">>
  <<set _previewHair to clone($wardrobePreview.current.hair)>>
  <<set _previewHair.type to _args[0]>><<set _previewHair.fringe to _args[1]>>
  <<set _previewHair.ruffledisable to "f">>
  <<set $wardrobePreview.current.hair to _previewHair>>
  <<wardrobePreviewRefresh "hair">>
<</widget>>

<<widget "wardrobePreviewChangeMakeup">>
  <<set _previewMakeup to clone($wardrobePreview.current.makeup)>>
	<<set _previewCategory to _args[0]>>
	<<set _previewColour to _args[1]>>
	<<if _previewCategory is "eyelenses">>
	<<set _previewMakeup.eyelenses to {left:_previewColour,right:_previewColour}>>
	<<else>>
	<<set _previewOwned to _previewMakeup.owned[_previewCategory] || []>>
	<<set _previewOwnedItem to _previewOwned.find(item => item.colour is _previewColour)>>
	<<if _previewOwnedItem and _previewOwnedItem.count gt 0>>
	<<set _previewMakeup[_previewCategory] to _previewColour>>
	<</if>>
	<</if>>
	<<set $wardrobePreview.current.makeup to _previewMakeup>>
	<<wardrobePreviewRefresh "makeup">>
<</widget>>

<<widget "wardrobePreviewConsumeMakeupCharges">>
  <<set _previewMakeup to clone($wardrobePreview.current.makeup)>>
	<<set _previewAppliedMakeup to $wardrobePreview.makeupApplied || $wardrobePreview.baseline.makeup>>
  <<for _previewCategory range ["lipstick", "eyeshadow", "mascara", "blusher"]>>
    <<if _previewMakeup[_previewCategory] isnot 0 and _previewMakeup[_previewCategory] isnot _previewAppliedMakeup[_previewCategory]>>
	<<set _previewOwned to _previewMakeup.owned[_previewCategory] || []>>
	<<set _previewOwnedItem to _previewOwned.find(item => item.colour is _previewMakeup[_previewCategory])>>
	<<if _previewOwnedItem and _previewOwnedItem.count gt 0>>
	<<set _previewOwnedItem.count-->>
	<</if>>
	<</if>>
  <</for>>
  <<set $wardrobePreview.current.makeup to _previewMakeup>>
<</widget>>

<<widget "wardrobePreviewApplyMakeup">>
  <<set $wardrobePreview.makeupApplied to clone($wardrobePreview.current.makeup)>>
  <<if _args[0] isnot true>>
	<<wardrobePreviewRefresh "makeup">>
	<</if>>
<</widget>>

<<widget "wardrobePreviewResetMakeup">>
  <<set $wardrobePreview.current.makeup to clone($wardrobePreview.makeupApplied || $wardrobePreview.baseline.makeup)>>
	<<wardrobePreviewRefresh "makeup">>
<</widget>>

<<widget "wardrobePreviewRemoveMakeup">>
  <<set _previewMakeup to clone($wardrobePreview.current.makeup)>>
	<<if _args[0] is "eyelenses">>
	<<set _previewMakeup.eyelenses to {left:0,right:0}>>
	<<else>>
	<<set _previewMakeup[_args[0]] to 0>>
	<<if _args[0] is "mascara">>
	<<set _previewMakeup.mascara_running to 0>>
	<</if>>
	<</if>>
	<<set $wardrobePreview.current.makeup to _previewMakeup>>
	<<wardrobePreviewRefresh "makeup">>
<</widget>>

<<widget "wardrobePreviewToggleConcealer">>
  <<set _previewMakeup to clone($wardrobePreview.current.makeup)>>
	<<set _previewMakeup.concealer to _previewMakeup.concealer is 1 ? 0 : 1>>
	<<set $wardrobePreview.current.makeup to _previewMakeup>>
	<<wardrobePreviewRefresh "makeup">>
<</widget>>

<<widget "wardrobePreviewChangeFaceVariant">>
  <<set _previewFace to clone($wardrobePreview.current.face)>>
  <<set _previewFace.variant to _args[0]>>
  <<set $wardrobePreview.current.face to _previewFace>>
  <<wardrobePreviewRefresh "makeup">>
<</widget>>

<<widget "wardrobeHairEnsureState">>
  <<if $wardrobePreview is undefined>><<wardrobePreviewSnapshot>><</if>>
  <<if $wardrobeHairFavorites is undefined or $wardrobeHairFavorites.sides is undefined or $wardrobeHairFavorites.fringe is undefined>>
    <<set $wardrobeHairFavorites to {sides: ($wardrobeHairFavorites and Array.isArray($wardrobeHairFavorites.sides)) ? $wardrobeHairFavorites.sides : [], fringe: ($wardrobeHairFavorites and Array.isArray($wardrobeHairFavorites.fringe)) ? $wardrobeHairFavorites.fringe : []}>>
  <</if>>
  <<if $wardrobePreview.hairUi is undefined>>
    <<set $wardrobePreview.hairUi to {section:"browse", mode:"mix", layer:"sides", category:null}>>
  <</if>>
  <<set $wardrobePreview.hairUi.section to ($wardrobePreview.hairUi.section is "browse") ? "browse" : "my">>
  <<set $wardrobePreview.hairUi.mode to ($wardrobePreview.hairUi.mode is "single") ? "single" : "mix">>
  <<set $wardrobePreview.hairUi.layer to ($wardrobePreview.hairUi.layer is "fringe") ? "fringe" : "sides">>
  <<if $wardrobePreview.hairUi.section is "my">><<set $wardrobePreview.hairUi.category to null>><</if>>
  <<run ["sides", "fringe"].forEach(layer => { const catalogue = setup.hairstyles[layer] || []; const valid = new Set(catalogue.map(style => style.variable)); $wardrobeHairFavorites[layer] = $wardrobeHairFavorites[layer].filter(variable => valid.has(variable)); })>>
<</widget>>

<<widget "wardrobeHairSetView">>
  <<wardrobeHairEnsureState>>
  <<set $wardrobePreview.hairUi.section to _args[0]>><<set $wardrobePreview.hairUi.layer to _args[1]>><<set $wardrobePreview.hairUi.category to _args[0] is "browse" ? null : null>>
  <<wardrobePreviewRefresh "hair">>
<</widget>>

<<widget "wardrobeHairSetMode">>
  <<wardrobeHairEnsureState>><<set $wardrobePreview.hairUi.section to "browse">><<set $wardrobePreview.hairUi.mode to _args[0]>><<set $wardrobePreview.hairUi.category to null>><<wardrobePreviewRefresh "hair">>
<</widget>>

<<widget "wardrobeHairOpenCategory">>
  <<wardrobeHairEnsureState>><<set $wardrobePreview.hairUi.section to "browse">><<set $wardrobePreview.hairUi.category to _args[0]>><<wardrobePreviewRefresh "hair">>
<</widget>>

<<widget "wardrobeHairBackToCategories">>
  <<wardrobeHairEnsureState>><<set $wardrobePreview.hairUi.category to null>><<wardrobePreviewRefresh "hair">>
<</widget>>

<<widget "wardrobeHairToggleFavorite">>
  <<wardrobeHairEnsureState>>
  <<set _hairFavoriteLayer to _args[0]>><<set _hairFavoriteVariable to _args[1]>><<set _hairFavoriteList to $wardrobeHairFavorites[_hairFavoriteLayer]>><<set _hairFavoriteIndex to _hairFavoriteList.indexOf(_hairFavoriteVariable)>>
  <<if _hairFavoriteIndex gte 0>><<run _hairFavoriteList.splice(_hairFavoriteIndex, 1)>><<else>><<run _hairFavoriteList.unshift(_hairFavoriteVariable)>><</if>>
  <<wardrobePreviewRefresh "hair">>
<</widget>>

<<widget "wardrobeHairTryRandom">>
  <<wardrobeHairEnsureState>>
  <<set _hairRandomSideCandidates to setup.hairstyles.sides || []>>
  <<set _hairRandomFringeCandidates to setup.hairstyles.fringe || []>>
  <<if _hairRandomSideCandidates.length gt 1>><<set _hairRandomSideAlternatives to _hairRandomSideCandidates.filter(style => style.variable isnot $wardrobePreview.current.hair.type)>><<if _hairRandomSideAlternatives.length gt 0>><<set _hairRandomSideCandidates to _hairRandomSideAlternatives>><</if>><</if>>
  <<if _hairRandomFringeCandidates.length gt 1>><<set _hairRandomFringeAlternatives to _hairRandomFringeCandidates.filter(style => style.variable isnot $wardrobePreview.current.hair.fringe)>><<if _hairRandomFringeAlternatives.length gt 0>><<set _hairRandomFringeCandidates to _hairRandomFringeAlternatives>><</if>><</if>>
  <<if _hairRandomSideCandidates.length gt 0 and _hairRandomFringeCandidates.length gt 0>>
    <<set _hairRandomPreview to clone($wardrobePreview.current.hair)>>
    <<set _hairRandomPreview.type to _hairRandomSideCandidates[random(0, _hairRandomSideCandidates.length - 1)].variable>>
    <<set _hairRandomPreview.fringe to _hairRandomFringeCandidates[random(0, _hairRandomFringeCandidates.length - 1)].variable>>
    <<set $wardrobePreview.current.hair to _hairRandomPreview>>
    <<wardrobePreviewRefresh "hair">>
  <</if>>
<</widget>>

<<widget "wardrobeHairCardPreview">>
  <<if $options.images is 1>>
    <<set _hairCardCanvasId to "wardrobe-hair-card-" + _args[1] + "-" + _args[2]>><div class="wardrobe-hair-card-viewport">
      <<wardrobePreviewProjectCurrent>>
      <<if _args[1] is "single">>
        <<set $hairtype to _args[0].sides>><<set $fringetype to _args[0].fringe>>
      <<else>>
        <<if _args[1] is "sides">><<set $hairtype to _args[0].variable>><<set $fringetype to "flat">><<else>><<set $fringetype to _args[0].variable>><</if>>
      <</if>>
      <<selectmodel "main" _hairCardCanvasId>><<modelprepare-player-body>><<modelprepare-player-clothes>><<if _args[1] is "fringe">><<set _modeloptions.show_hair_sides to false>><</if>><<hidelayer "base">><<hidelayer "breasts">><<hidelayer "belly">><<hidelayer "bellyLeft">><<hidelayer "bellyRight">><<hidelayer "leftarm">><<hidelayer "rightarm">><<set _modeloptions.show_clothes to false>><<set _modeloptions.show_tf to false>><<set _modeloptions.show_writings to false>><<set _modeloptions.show_face to true>><<set _modeloptions.show_hair to true>><<set _modeloptions.arm_left to "none">><<set _modeloptions.arm_right to "none">><<set _modeloptions.blink to false>><<set _modeloptions.eyes_half to false>><<set _modeloptions.mouth to "neutral">><<set _modeloptions.trauma to false>><<set _modeloptions.precipitation to false>><<set _modeloptions.temperature to false>><<rendermodel "wardrobe-hair-card-canvas">>
      <<wardrobePreviewRestoreProjection>>
    </div>
  <<else>>
    <span class="wardrobe-hair-card-text-fallback"><<print window.wardrobeHairDisplayName(_args[0])>></span>
  <</if>>
<</widget>>

<<widget "wardrobeHairCard">>
  <<set _hairCardStyle to _args[0]>><<set _hairCardLayer to _args[1]>><<set _hairCardIndex to _args[2]>><<set _hairCardKey to _hairCardLayer is "sides" ? "type" : "fringe">><<set _hairCardVariable to _hairCardStyle.variable>><<set _hairCardName to window.wardrobeHairDisplayName(_hairCardStyle)>><<set _hairCardFavorites to $wardrobeHairFavorites[_hairCardLayer] || []>><<set _hairCardIsFavorite to _hairCardFavorites.includes(_hairCardVariable)>><<set _hairCardCurrent to _hairCardLayer is "sides" ? $wardrobePreview.current.hair.type : $wardrobePreview.current.hair.fringe>><<set _hairCardSelected to _hairCardCurrent is _hairCardVariable>>
  <div @class="'wardrobe-hair-card' + (_hairCardSelected && _hairCardIsFavorite ? ' wardrobe-hair-card-selected' : '')" @title="_hairCardName" @aria-label="_hairCardName">
    <<wardrobeHairCardPreview _hairCardStyle _hairCardLayer _hairCardIndex>>
    <div class="wardrobe-hair-card-action no-numberify">
      <<capture _hairCardStyle _hairCardLayer _hairCardIndex _hairCardKey>>
        <<link " ">><span class="wardrobe-hair-card-link-name"><<print window.wardrobeHairDisplayName(_hairCardStyle)>></span><<wardrobePreviewChangeHair _hairCardKey _hairCardStyle.variable>><</link>>
      <</capture>>
    </div>
    <span @class="'wardrobe-hair-favorite no-numberify' + (_hairCardIsFavorite ? ' wardrobe-hair-favorite-active' : '')" @title="(_hairCardIsFavorite ? 'Remove ' : 'Add ') + _hairCardName + ' to My Styles'">
      <<capture _hairCardLayer _hairCardVariable>>
        <<link `_hairCardIsFavorite ? "★" : "☆"`>><span class="wardrobe-hair-sr-label"><<print (_hairCardIsFavorite ? "Remove " : "Add ") + _hairCardName + " to My Styles">></span><<wardrobeHairToggleFavorite _hairCardLayer _hairCardVariable>><</link>>
      <</capture>>
    </span>
  </div>
<</widget>>

<<widget "wardrobeHairSingleCard">>
  <<set _hairSingleStyle to _args[0]>><<set _hairSingleIndex to _args[1]>><<set _hairSingleName to window.wardrobeHairDisplayName(_hairSingleStyle)>><<set _hairSingleSelected to $wardrobePreview.current.hair.type is _hairSingleStyle.sides and $wardrobePreview.current.hair.fringe is _hairSingleStyle.fringe>>
  <div @class="'wardrobe-hair-card' + (_hairSingleSelected ? ' wardrobe-hair-card-selected' : '')" @title="_hairSingleName" @aria-label="_hairSingleName">
    <<wardrobeHairCardPreview _hairSingleStyle "single" _hairSingleIndex>>
    <div class="wardrobe-hair-card-action no-numberify">
      <<capture _hairSingleStyle _hairSingleName>>
        <<link " ">><span class="wardrobe-hair-card-link-name"><<print _hairSingleName>></span><<wardrobePreviewChangeHairSingle _hairSingleStyle.sides _hairSingleStyle.fringe>><</link>>
      <</capture>>
    </div>
  </div>
<</widget>>

<<widget "wardrobeHairRenderSingleStyles">>
  <<set _hairSingleStyles to setup.hairSingleStyles || []>>
  <div class="no-numberify">
    <div class="wardrobe-hair-section-header"><span>Single Styles</span></div>
    <div class="wardrobe-hair-card-grid wardrobe-hair-single-card-grid">
      <<set _hairSingleIndex to 0>>
      <<for _hairSingleStyle range _hairSingleStyles>>
        <<capture _hairSingleStyle _hairSingleIndex>><<wardrobeHairSingleCard _hairSingleStyle _hairSingleIndex>><</capture>>
        <<set _hairSingleIndex += 1>>
      <</for>>
    </div>
  </div>
<</widget>>

<<widget "wardrobeHairRenderMyColumn">>
  <<set _hairMyColumnLayer to _args[0]>><<set _hairMyColumnStyles to []>><<for _hairMyFavorite range $wardrobeHairFavorites[_hairMyColumnLayer]>><<set _hairMyColumnStyle to (setup.hairstyles[_hairMyColumnLayer] || []).find(style => style.variable is _hairMyFavorite)>><<if _hairMyColumnStyle>><<run _hairMyColumnStyles.push(_hairMyColumnStyle)>><</if>><</for>>
  <section class="wardrobe-hair-my-column">
    <div class="wardrobe-hair-section-header"><span><<print _hairMyColumnLayer is "sides" ? "Sides" : "Fringe">></span></div>
    <<if _hairMyColumnStyles.length gt 0>>
      <div class="wardrobe-hair-card-grid"><<for _hairMyColumnStyle range _hairMyColumnStyles>><<set _hairMyColumnVariable to _hairMyColumnStyle.variable>><<capture _hairMyColumnStyle _hairMyColumnLayer _hairMyColumnVariable>><<wardrobeHairCard _hairMyColumnStyle _hairMyColumnLayer _hairMyColumnVariable>><</capture>><</for>></div>
    <</if>>
  </section>
<</widget>>

<<widget "wardrobeHairRenderCategoryTiles">>
  <<wardrobeHairEnsureState>>
  <<set _hairTileLayer to $wardrobePreview.hairUi.layer>><<set _hairTileCategories to window.wardrobeHairCategories(_hairTileLayer)>><div class="wardrobe-hair-category-grid">
    <<for _hairTileCategory range _hairTileCategories>>
      <<set _hairTileStyles to (setup.hairstyles[_hairTileLayer] || []).filter(style => window.wardrobeHairMatches(style, _hairTileCategory) and !window.wardrobeHairIsSingleStyle(_hairTileLayer, style.variable))>><<set _hairTileCount to _hairTileStyles.length>><<set _hairTilePreview to _hairTileStyles.find(style => style.variable is _hairTileCategory.preview) || _hairTileStyles[0]>><<set _hairTileCategoryId to _hairTileCategory.id>>
      <<if _hairTileStyles.length gt 0>><div class="wardrobe-hair-category-tile">
        <div class="wardrobe-hair-category-preview">
          <<if _hairTilePreview>><<capture _hairTilePreview _hairTileLayer _hairTileCategoryId>><<wardrobeHairCardPreview _hairTilePreview _hairTileLayer _hairTileCategoryId>><</capture>><<else>><span class="wardrobe-hair-category-empty">No styles</span><</if>>
        </div>
        <div class="wardrobe-hair-category-info"><span class="wardrobe-hair-category-label"><<print _hairTileCategory.label>></span></div>
        <<capture _hairTileCategoryId>><span class="wardrobe-hair-category-action"><<link " ">><<wardrobeHairOpenCategory _hairTileCategoryId>><</link>></span><</capture>>
      </div><</if>>
    <</for>>
  </div>
<</widget>>

<<widget "wardrobePreviewRenderHairPanel">>
  <<wardrobeHairEnsureState>>
  <<set _hairLayer to $wardrobePreview.hairUi.layer>><<set _hairLayerKey to _hairLayer is "sides" ? "type" : "fringe">><<set _hairCurrentVariable to _hairLayer is "sides" ? $wardrobePreview.current.hair.type : $wardrobePreview.current.hair.fringe>><<set _hairCurrentStyle to (setup.hairstyles[_hairLayer] || []).find(style => style.variable is _hairCurrentVariable) || {name:_hairCurrentVariable, name_cap:_hairCurrentVariable, variable:_hairCurrentVariable, type:[]}>><<set _hairCategories to window.wardrobeHairCategories(_hairLayer)>><<set _hairOpenCategoryId to $wardrobePreview.hairUi.category>><<set _hairOpenCategory to _hairOpenCategoryId ? _hairCategories.find(category => category.id is _hairOpenCategoryId) : null>>
  <div class="wardrobe-hair-studio">
    <div class="wardrobe-hair-heading"><span class="gold bold">Hair</span><span class="wardrobe-hair-random-link blue"><<link "Try random style">><<wardrobeHairTryRandom>><</link>></span></div>
    <div class="wardrobe-hair-current-summary"><span>Sides: <<print window.wardrobeHairDisplayName((setup.hairstyles.sides || []).find(style => style.variable is $wardrobePreview.current.hair.type) || {name:$wardrobePreview.current.hair.type})>></span><span>Fringe: <<print window.wardrobeHairDisplayName((setup.hairstyles.fringe || []).find(style => style.variable is $wardrobePreview.current.hair.fringe) || {name:$wardrobePreview.current.hair.fringe})>></span></div>
    <div class="wardrobe-hair-browser">
    <div class="wardrobe-hair-segmented wardrobe-hair-nav-primary" role="tablist" aria-label="Hair view">
      <span @class="'wardrobe-hair-segment-link' + ($wardrobePreview.hairUi.section is 'browse' ? ' active' : '')"><<link "Browse">><<set $wardrobePreview.hairUi.section to "browse">><<set $wardrobePreview.hairUi.category to null>><<wardrobePreviewRefresh "hair">><</link>></span>
      <span @class="'wardrobe-hair-segment-link' + ($wardrobePreview.hairUi.section is 'my' ? ' active' : '')"><<link "My Styles">><<set $wardrobePreview.hairUi.section to "my">><<set $wardrobePreview.hairUi.category to null>><<wardrobePreviewRefresh "hair">><</link>></span>
    </div>
    <div @class="'wardrobe-hair-browser-box wardrobe-hair-browser-' + $wardrobePreview.hairUi.section">
    <<if $wardrobePreview.hairUi.section is "my">>
      <div class="wardrobe-hair-my-grid"><<wardrobeHairRenderMyColumn "sides">><<wardrobeHairRenderMyColumn "fringe">></div>
     <<else>>
       <div @class="'wardrobe-hair-nav-secondary-layout wardrobe-hair-nav-secondary-layout-' + $wardrobePreview.hairUi.mode">
        <div class="wardrobe-hair-segmented wardrobe-hair-nav-secondary" role="tablist" aria-label="Hair selection mode">
          <span @class="'wardrobe-hair-segment-link' + ($wardrobePreview.hairUi.mode is 'mix' ? ' active' : '')"><<link "Mix & Match">><<wardrobeHairSetMode "mix">><</link>></span>
          <span @class="'wardrobe-hair-segment-link' + ($wardrobePreview.hairUi.mode is 'single' ? ' active' : '')"><<link "Single Styles">><<wardrobeHairSetMode "single">><</link>></span>
        </div>
       </div>
       <<if $wardrobePreview.hairUi.mode is "mix">>
        <div class="wardrobe-hair-mix-panel">
         <div class="wardrobe-hair-segmented wardrobe-hair-nav-tertiary" role="tablist" aria-label="Hair layer">
          <span @class="'wardrobe-hair-segment-link' + ($wardrobePreview.hairUi.layer is 'sides' ? ' active' : '')"><<link "Sides">><<set $wardrobePreview.hairUi.layer to "sides">><<set $wardrobePreview.hairUi.category to null>><<wardrobePreviewRefresh "hair">><</link>></span>
          <span @class="'wardrobe-hair-segment-link' + ($wardrobePreview.hairUi.layer is 'fringe' ? ' active' : '')"><<link "Fringe">><<set $wardrobePreview.hairUi.layer to "fringe">><<set $wardrobePreview.hairUi.category to null>><<wardrobePreviewRefresh "hair">><</link>></span>
         </div>
        </div>
         <<if _hairOpenCategory is null>>
         <div class="no-numberify"><div class="wardrobe-hair-section-header"><span>Browse <<print _hairLayer is "sides" ? "Sides" : "Fringe">></span></div>
         <<wardrobeHairRenderCategoryTiles>></div>
       <<else>>
         <<set _hairCategoryStyles to (setup.hairstyles[_hairLayer] || []).filter(style => window.wardrobeHairMatches(style, _hairOpenCategory) and !window.wardrobeHairIsSingleStyle(_hairLayer, style.variable))>><<set _hairCategoryCount to _hairCategoryStyles.length>><<set _hairCategoryFavorites to $wardrobeHairFavorites[_hairLayer] || []>><<run _hairCategoryStyles.sort((a,b) => { const af = _hairCategoryFavorites.indexOf(a.variable); const bf = _hairCategoryFavorites.indexOf(b.variable); if (af !== -1 || bf !== -1) return af === -1 ? 1 : bf === -1 ? -1 : af - bf; return window.wardrobeHairDisplayName(a).localeCompare(window.wardrobeHairDisplayName(b)); })>>
         <div class="wardrobe-hair-category-header no-numberify"><span class="wardrobe-hair-category-back"><<link "< Back">><<wardrobeHairBackToCategories>><</link>></span><span class="wardrobe-hair-category-title"><<print _hairOpenCategory.label>></span></div>
         <div class="wardrobe-hair-card-grid no-numberify"><<for _hairCategoryStyle range _hairCategoryStyles>><<set _hairCategoryVariable to _hairCategoryStyle.variable>><<capture _hairCategoryStyle _hairLayer _hairCategoryVariable>><<wardrobeHairCard _hairCategoryStyle _hairLayer _hairCategoryVariable>><</capture>><</for>></div>
       <</if>>
       <<else>>
         <<wardrobeHairRenderSingleStyles>>
       <</if>>
     <</if>>
    </div>
    </div>
   </div>
<</widget>>

<<widget "wardrobePreviewRenderFaceVariantIcon">>
  <<if $options.images is 1>>
    <<set _faceIconProjectionState to clone(V)>>
    <<wardrobePreviewProjectCurrent>>
    <<set $facevariant to _args[0]>>
    <div class="wardrobe-face-choice-viewport">
      <<selectmodel "main" _args[1]>>
      <<modelprepare-player-body>>
      <<hidelayer "base">>
      <<hidelayer "breasts">>
      <<hidelayer "belly">>
      <<hidelayer "bellyLeft">>
      <<hidelayer "bellyRight">>
      <<hidelayer "leftarm">>
      <<hidelayer "rightarm">>
      <<set _modeloptions.show_clothes to false>>
      <<set _modeloptions.show_tf to false>>
      <<set _modeloptions.show_writings to false>>
      <<set _modeloptions.show_face to true>>
      <<set _modeloptions.show_hair to true>>
      <<set _modeloptions.arm_left to "none">>
      <<set _modeloptions.arm_right to "none">>
      <<set _modeloptions.blink to false>>
      <<set _modeloptions.eyes_half to false>>
      <<set _modeloptions.eyes_bloodshot to false>>
      <<set _modeloptions.trauma to false>>
      <<set _modeloptions.brows to "top">>
      <<set _modeloptions.mouth to "neutral">>
      <<set _modeloptions.tears to 0>>
      <<set _modeloptions.blush to 0>>
      <<set _modeloptions.toast to 0>>
      <<set _modeloptions.follower to false>>
      <<set _modeloptions.drip_vaginal to "">>
      <<set _modeloptions.drip_anal to "">>
      <<set _modeloptions.drip_mouth to "">>
      <<set _modeloptions.precipitation to false>>
      <<set _modeloptions.temperature to false>>
      <<set _modeloptions.prop to false>>
      <<set _modeloptions.wraithFlash to false>>
      <<rendermodel _args[1]>>
    </div>
    <<run Object.keys(V).forEach(key => delete V[key]); Object.assign(V, _faceIconProjectionState)>>
  <<else>>
    <span class="wardrobe-face-choice-placeholder">Face preview</span>
  <</if>>
<</widget>>
<<widget "wardrobePreviewRenderMakeupPanel">>
  <<set _previewMakeupCategories to ["lipstick", "eyeshadow", "mascara", "blusher"]>>
  <<set _previewMakeupIconFiles to {lipstick:"cosmetics.gif", eyeshadow:"eyeshadow.png", mascara:"mascara.png", blusher:"blusher.png"}>>
  <div class="settingsGrid wardrobe-preview-style-grid"><div class="settingsHeader">Makeup</div>
    <<for _category range _previewMakeupCategories>>
      <div class="settingsToggleItemWide"><<cosmeticsicon _category>> <span class="gold bold"><<print _category.toUpperFirst()>>
	</span>:
        <<if $wardrobePreview.current.makeup[_category] isnot 0>>
	<<set _previewWornName to $wardrobePreview.current.makeup[_category].replace(" waterproof", "").toUpperFirst()>>
	<span class="makeupWorn"><<print _previewWornName>>
	</span><</if>>
        <<set _previewOwned to $wardrobePreview.current.makeup.owned[_category] || []>>
        <div class="wardrobe-makeup-choice-list no-numberify">
          <<for _item range _previewOwned>>
	<<if _item.count gt 0>>
	<<capture _category _item>>
            <<set _previewMakeupIconClass to _category + "-" + _item.colour.replace(/ /g, "-")>>
            <<set _previewMakeupIconFile to _previewMakeupIconFiles[_category]>>
            <<set _previewMakeupButtonLabel to '<span class="wardrobe-makeup-choice"><span class="wardrobe-makeup-choice-icon ' + _previewMakeupIconClass + '"><img class="icon" src="img/misc/icon/' + _previewMakeupIconFile + '" alt=""></span><span class="wardrobe-makeup-choice-count">×' + _item.count + '</span></span>'>>
            <<button _previewMakeupButtonLabel>>
	<<wardrobePreviewChangeMakeup _category _item.colour>>
	<</button>>
          <</capture>>
	<</if>>
	<</for>>
        </div>
      </div>
    <</for>>
    <<set _previewFaceVariants to Object.entries(setup.faceVariantOptions[$wardrobePreview.current.face.style] || {})>>
    <div class="settingsToggleItemWide">
      <span class="gold bold">Demeanour</span>:
      <div class="wardrobe-makeup-choice-list wardrobe-face-choice-list no-numberify">
        <<for _variant range _previewFaceVariants>>
          <<capture _variant>>
            <<set _faceVariantCanvasId to "wardrobe-face-variant-" + _variant[1].replace(/[^a-z0-9]+/gi, "-")>>
            <div @class="'wardrobe-face-choice-card' + ($wardrobePreview.current.face.variant is _variant[1] ? ' active' : '')">
              <span class="wardrobe-face-choice-icon"><<wardrobePreviewRenderFaceVariantIcon _variant[1] _faceVariantCanvasId>></span>
              <span class="wardrobe-face-choice-label"><<print _variant[0]>></span>
              <span class="wardrobe-face-choice-action no-numberify"><<button " ">><<wardrobePreviewChangeFaceVariant _variant[1]>><</button>></span>
            </div>
          <</capture>>
        <</for>>
      </div>
    </div>
    <div class="settingsToggleItemWide"><<cosmeticsicon "contacts">> <span class="gold bold">Contacts</span>:
      <<if $wardrobePreview.current.makeup.eyelenses.left isnot 0>>
	<span class="makeupWorn">Worn</span><</if>>
      <div class="wardrobe-makeup-choice-list no-numberify">
        <<for _colour range ($wardrobePreview.current.makeup.owned.eyelenses || [])>>
	<<capture _colour>>
          <<set _previewContactIconClass to "eye-" + _colour.replace(/ /g, "-")>>
          <<set _previewContactButtonLabel to '<span class="wardrobe-makeup-choice"><span class="wardrobe-makeup-choice-icon ' + _previewContactIconClass + '"><img class="icon" src="img/misc/icon/contacts.png" alt=""></span></span>'>>
          <<button _previewContactButtonLabel>>
	<<wardrobePreviewChangeMakeup "eyelenses" _colour>>
	<</button>>
        <</capture>>
	<</for>>
      </div>
    </div>
    <<if $player.freckles is true>>
	<div class="settingsToggleItemWide"><<cosmeticsicon>> <span class="gold bold">Concealer</span>: <<if $wardrobePreview.current.makeup.concealer is 1>>Applied<<else>>
	<span class="no-numberify"><<link "Apply">>
	<<wardrobePreviewToggleConcealer>>
	<</link>>
	</span><</if>>
	</div><</if>>
    <<if $wardrobePreview.current.makeup.lipstick isnot 0 or $wardrobePreview.current.makeup.eyeshadow isnot 0 or $wardrobePreview.current.makeup.mascara isnot 0 or $wardrobePreview.current.makeup.blusher isnot 0 or $wardrobePreview.current.makeup.eyelenses.left isnot 0 or $wardrobePreview.current.makeup.concealer is 1>>
      <div class="settingsToggleItemWide wardrobe-makeup-removals">
        <span class="gold bold">Remove:</span>
        <<if $wardrobePreview.current.makeup.lipstick isnot 0>>
	<span class="no-numberify"><<link "Remove Lipstick">>
	<<wardrobePreviewRemoveMakeup "lipstick">>
	<</link>>
	</span> <</if>>
        <<if $wardrobePreview.current.makeup.eyeshadow isnot 0>>
	<span class="no-numberify"><<link "Remove Eyeshadow">>
	<<wardrobePreviewRemoveMakeup "eyeshadow">>
	<</link>>
	</span> <</if>>
        <<if $wardrobePreview.current.makeup.mascara isnot 0>>
	<span class="no-numberify"><<link "Remove Mascara">>
	<<wardrobePreviewRemoveMakeup "mascara">>
	<</link>>
	</span> <</if>>
        <<if $wardrobePreview.current.makeup.blusher isnot 0>>
	<span class="no-numberify"><<link "Remove Blusher">>
	<<wardrobePreviewRemoveMakeup "blusher">>
	<</link>>
	</span> <</if>>
        <<if $wardrobePreview.current.makeup.eyelenses.left isnot 0>>
	<span class="no-numberify"><<link "Remove Contacts">>
	<<wardrobePreviewRemoveMakeup "eyelenses">>
	<</link>>
	</span> <</if>>
        <<if $wardrobePreview.current.makeup.concealer is 1>>
	<span class="no-numberify"><<link "Remove Concealer">>
	<<wardrobePreviewToggleConcealer>>
	<</link>>
	</span><</if>>
      </div>
    <</if>>

  </div>
<</widget>>

<<widget "wardrobePreviewRenderClothingPanel">>
  <<wardrobeClothingEnsureState>>
  <<set _clothingSlot to $wardrobePreview.clothingUi.slot>>
  <<set _clothingSlotLabels to {head:"Head", face:"Face", neck:"Neck", over_head:"Outer head", over_upper:"Outer upper", hands:"Hands", handheld:"Handheld", upper:"Upper", under_upper:"Under upper", lower:"Lower", under_lower:"Under lower", genitals:"Genitals", over_lower:"Outer lower", legs:"Legs", feet:"Feet"}>>
  <<set _clothingSlotLabel to _clothingSlotLabels[_clothingSlot] || _clothingSlot>>
  <div class="wardrobe-clothing-studio">
    <div class="wardrobe-clothing-heading"><span class="gold bold"><<print _clothingSlotLabel>></span><<if $wardrobePreview.current.worn[_clothingSlot] and $wardrobePreview.current.worn[_clothingSlot].name and $wardrobePreview.current.worn[_clothingSlot].name isnot "naked" and !window.wardrobeIsComboLowerLocked($wardrobePreview.current.worn, _clothingSlot)>><span class="wardrobe-clothing-current-action no-numberify"><<link "Unequip">><<wardrobePreviewRemove _clothingSlot "clothing">><</link>></span><</if>></div>
    <div class="wardrobe-clothing-current-summary">Choose an item to preview.</div>
    <div class="wardrobe-hair-browser-box wardrobe-clothing-browser-box">
      <<wardrobeClothingRenderItems _clothingSlot>>
    </div>
  </div>
<</widget>>

<<widget "wardrobePreviewRenderStylePanel">>
  <<if _args[0] is "hair">>
    <<wardrobePreviewRenderHairPanel>>
  <<elseif _args[0] is "clothing">>
    <<wardrobePreviewRenderClothingPanel>>
  <<else>>
    <<wardrobePreviewRenderMakeupPanel>>
  <</if>>
<</widget>>

<<widget "wardrobePreviewRefresh">>
  <<for _refreshCycle = 0; _refreshCycle lt 2; _refreshCycle++>>
  <<if $('#wardrobeList')[0]>>
	<<replace '#wardrobeList'>>
	<<wardrobeContents>>
	<</replace>>
	<</if>>
  <<if $('#wardrobePaperDoll')[0]>>
	<<replace '#wardrobePaperDoll'>>
	<<wardrobePaperDoll>>
	<</replace>>
	<</if>>
  <<if $('#clotheson')[0]>>
	<<replace '#clotheson'>>
	<<wardrobePreviewRenderClothesOn>>
	<</replace>>
	<</if>>
  <<if $('#wardrobeApply')[0]>>
	<<replace '#wardrobeApply'>>
	<<wardrobeApplyChanges>>
	<</replace>>
	<</if>>
  <<if $('#wardrobeRightPanel')[0]>>
    <<if _args[0] is "hair" or _args[0] is "makeup" or _args[0] is "clothing">>
      <<if $('#wardrobeRightPanel .wardrobe-style-mirror')[0]>>
        <<if _args[0] is "hair">>
          <<run $('#wardrobeRightPanel .wardrobe-style-mirror').html(new Wikifier(null, "<<wardrobePreviewRenderStylePanel hair>>").output)>>
        <<elseif _args[0] is "clothing">>
          <<run $('#wardrobeRightPanel .wardrobe-style-mirror').html(new Wikifier(null, "<<wardrobePreviewRenderStylePanel clothing>>").output)>>
        <<else>>
          <<run $('#wardrobeRightPanel .wardrobe-style-mirror').html(new Wikifier(null, "<<wardrobePreviewRenderStylePanel makeup>>").output)>>
        <</if>>
      <<else>>
        <<replace '#wardrobeRightPanel'>>
	<<wardrobeStylePanel _args[0]>>
	<</replace>>
      <</if>>
    <<else>>
      <<replace '#wardrobeRightPanel'>>
	<<wardrobeRightSummary>>
	<</replace>>
    <</if>>
  <</if>>
  <<run Links.throttle = 0; Links.generateLinkNumbers($(".passage"))>>
  <</for>>
<</widget>>

<<widget "wardrobePreviewCommit">>
  <<wardrobePreviewConsumeMakeupCharges>>
	<<wardrobePreviewApplyMakeup true>>
  <<set $worn to clone($wardrobePreview.current.worn)>>
	<<set $carried to clone($wardrobePreview.current.carried)>>
  <<if $wardrobePreview.location is "wardrobe">>
	<<set $wardrobe to clone($wardrobePreview.current.wardrobe)>>
	<<else>>
	<<set $wardrobes[$wardrobePreview.location] to clone($wardrobePreview.current.wardrobe)>>
	<</if>>
  <<set $hairtype to $wardrobePreview.current.hair.type>>
	<<set $fringetype to $wardrobePreview.current.hair.fringe>>
	<<set $hairposition to $wardrobePreview.current.hair.position>>
	<<set $hairlength to $wardrobePreview.current.hair.length>>
	<<set $hairlengthstage to $wardrobePreview.current.hair.lengthStage>>
	<<set $fringelength to $wardrobePreview.current.hair.fringeLength>>
	<<set $fringelengthstage to $wardrobePreview.current.hair.fringeLengthStage>>
	<<set $haircolour to $wardrobePreview.current.hair.colour>>
	<<set $hairfringecolour to $wardrobePreview.current.hair.fringeColour>>
	<<set $hairColourGradient to $wardrobePreview.current.hair.colourGradient>>
	<<set $hairFringeColourGradient to $wardrobePreview.current.hair.fringeColourGradient>>
	<<set $hairColourStyle to $wardrobePreview.current.hair.colourStyle>>
  <<set $hairFringeColourStyle to $wardrobePreview.current.hair.fringeColourStyle>>
  <<set $ruffledisable to $wardrobePreview.current.hair.ruffledisable>>
  <<set $facestyle to $wardrobePreview.current.face.style>>
  <<set $facevariant to $wardrobePreview.current.face.variant>>
  <<set $makeup to clone($wardrobePreview.current.makeup)>>
<</widget>>

<<widget "wardrobePreviewDiscard">>
  <<unset $wardrobePreview>>
	<<unset $wardrobePreviewActive>>
	<<unset $wardrobePreviewTimeCost>>
<</widget>>

<<widget "wardrobeApplyChanges">>
  <<wardrobePreviewCalculateDiff>>
	<<set _previewChanges to $wardrobePreviewTimeCost>>
  <<link "Reset">>
	<<wardrobePreviewReset>>
	<</link>>
  <span class="wardrobe-action no-numberify"> | </span>
  <<if _previewChanges gt 0>>
    <<set _applyUnit to _previewChanges is 1 ? "minute" : "minutes">>
	<<set _applyLabel to "Apply changes (" + _previewChanges + " " + _applyUnit + ")">>
    <<link _applyLabel>>
	<<wardrobePreviewCalculateDiff>>
	<<if $wardrobePreviewTimeCost gt 0>>
	<<wardrobePreviewCommit>>
	<<pass $wardrobePreviewTimeCost>>
	<<wardrobePreviewSnapshot true>>
	<<updatesidebarimg>>
	<<updatesidebardescription>>
	<<updateallure>>
	<<updateattractivenessscale>>
	<<updateattractivenessdescription>>
	<<updatewarmthscale>>
	<<updatewarmthdescription>>
	<<wardrobePreviewRefresh>>
	<</if>>
	<</link>>
  <<else>>
    <span class="wardrobe-apply-idle">No changes to apply</span>
  <</if>>
  <span class="wardrobe-action no-numberify"> | <<link "Strip">>
	<<wardrobePreviewStrip>>
	<</link>>
	</span>
<</widget>>
<<widget "wardrobeContents">>
	<<if $lastWardrobeSlot is "NewOutfit">>
		<<wardrobeNewOutfit>>
	<<else>>
		<<wardrobeGrid>>
	<</if>>
<</widget>>

<<widget "wardrobeGrid">>
  <<set _selectedWardrobe to $wardrobePreview.current.wardrobe || selectWardrobe() || {}>>
  <<set _wardrobeGroups to [{label:"Underwear",slots:["under_upper","under_lower","genitals"]},{label:"Clothing",slots:["over_upper","over_lower","over_head","upper","lower"]},{label:"Accessories",slots:["head","face","neck","hands","handheld","legs","feet"]}]>>
  <div id="wardrobeGridList" class="wardrobe-grid-layout"><div class="wardrobe-grid-items"><<for _group range _wardrobeGroups>>
	<section class="wardrobe-grid-section"><h3 class="wardrobe-grid-section-title"><<print _group.label>>
	</h3><div class="wardrobe-grid" role="list"><<for _slot range _group.slots>>
	<<set _slotItems to Array.isArray(_selectedWardrobe[_slot]) ? _selectedWardrobe[_slot] : []>>
	<<if _slotItems.length is 0 and (!$wardrobePreview.current.worn[_slot] or $wardrobePreview.current.worn[_slot].name is "naked")>>
	<<continue>>
	<</if>>
	<<set _gridStoredItems to []>>
	<<for _i to 0; _i lt _slotItems.length; _i++>>
	<<set _gridCandidate to _slotItems[_i]>>
	<<if _gridCandidate and _gridCandidate.name and _gridCandidate.name isnot "naked">>
	<<run _gridStoredItems.push({item:_gridCandidate,index:_i,worn:false})>>
	<</if>>
	<</for>>
	<<if $wardrobePreview.current.worn[_slot] and $wardrobePreview.current.worn[_slot].name and $wardrobePreview.current.worn[_slot].name isnot "naked">>
	<<run _gridStoredItems.push({item:$wardrobePreview.current.worn[_slot],index:-1,worn:true})>>
	<</if>>
	<<run _gridStoredItems.sort((a,b)=>(a.item.name||"").localeCompare(b.item.name||"")||Number(b.worn)-Number(a.worn))>>
	<<for _gridEntry range _gridStoredItems>>
	<<set _item to _gridEntry.item>>
	<<if !_gridEntry.worn and _item.outfitSecondary isnot undefined and _item.outfitSecondary[1] isnot "broken" and _item.outfitSecondary[1] isnot "split">>
	<<continue>>
	<</if>>
	<<wardrobeGridTile _item _slot _gridEntry.index _gridEntry.worn>>
	<</for>>
	<</for>>
	</div></section><</for>>
	</div></div>
<</widget>>
<<widget "wardrobeClothingRenderItems">>
	<<set _clothingSlot to _args[0]>>
	<<set _selectedWardrobe to $wardrobePreview.current.wardrobe || selectWardrobe() || {}>>
	<<set _slotItems to Array.isArray(_selectedWardrobe[_clothingSlot]) ? _selectedWardrobe[_clothingSlot] : []>>
	<<set _clothingEntries to []>>
	<<for _i to 0; _i lt _slotItems.length; _i++>>
		<<set _clothingCandidate to _slotItems[_i]>>
		<<if _clothingCandidate and _clothingCandidate.name and _clothingCandidate.name isnot "naked">>
		<<set _clothingCandidateData to getSetupClothing(_clothingSlot, _clothingCandidate)>>
			<<set _clothingPrimarySlot to _clothingSlot is "under_lower" ? "under_upper" : "upper">>
			<<if (_clothingSlot is "lower" or _clothingSlot is "under_lower") and ((_clothingCandidateData.outfitSecondary isnot undefined and _clothingCandidateData.outfitSecondary[0] is _clothingPrimarySlot) or window.wardrobeIsComboLowerCandidate(_clothingCandidate, _clothingSlot))>>
				<<continue>>
			<</if>>
			<<run _clothingEntries.push({item:_clothingCandidate,index:_i,worn:false})>>
		<</if>>
	<</for>>
	<<if $wardrobePreview.current.worn[_clothingSlot] and $wardrobePreview.current.worn[_clothingSlot].name and $wardrobePreview.current.worn[_clothingSlot].name isnot "naked" and !window.wardrobeIsComboLowerLocked($wardrobePreview.current.worn, _clothingSlot)>>
		<<run _clothingEntries.push({item:$wardrobePreview.current.worn[_clothingSlot],index:-1,worn:true})>>
	<</if>>
	<<run _clothingEntries.sort((a,b)=>(a.item.name||"").localeCompare(b.item.name||"")||Number(b.worn)-Number(a.worn))>>
	<div class="wardrobe-clothing-card-grid" role="list">
		<<if _clothingEntries.length is 0>>
			<div class="wardrobe-clothing-empty"><span>No items available for this slot.</span></div>
		<<else>>
			<<for _clothingEntry range _clothingEntries>>
				<<wardrobeGridTile _clothingEntry.item _clothingSlot _clothingEntry.index _clothingEntry.worn true>>
			<</for>>
		<</if>>
	</div>
<</widget>>
<<widget "wardrobeGridTile">>
	<<set _gridItem to _args[0]>>
	<<set _gridSlot to _args[1]>>
	<<set _gridIndex to _args[2]>>
	<<set _gridIsWorn to _args[3] is true>>
	<<set _gridPanelFavorite to _args[4] is true>>
	<<set _gridRefreshPanel to _gridPanelFavorite ? "clothing" : undefined>>
	<<set _gridItemData to setup.clothes[_gridSlot][clothesIndex(_gridSlot,_gridItem)] || _gridItem>>
	<<set _gridName to _gridItemData.name_cap || _gridItem.name || "Unknown item">>
	<<set _gridGender to _gridItem.gender is "m" ? "m" : _gridItem.gender is "f" ? "f" : null>>
	<div @class="'wardrobe-grid-tile' + (!_gridPanelFavorite ? ' div-link' : '') + ' wardrobe-action no-numberify' + (_gridIsWorn ? ' wardrobe-grid-tile-worn' : '')" role="listitem">
	<<if _gridPanelFavorite>>
	<div class="wardrobe-grid-card-action no-numberify"><<capture _gridSlot _gridIndex _gridIsWorn _gridRefreshPanel _gridName>><<link " ">><span class="wardrobe-grid-card-action-sr-label"><<print _gridIsWorn ? "Unequip " : "Equip ">><<print _gridName>></span><<if _gridIsWorn>><<wardrobePreviewRemove _gridSlot _gridRefreshPanel>><<else>><<wardrobePreviewEquip _gridSlot _gridIndex _gridRefreshPanel>><</if>><</link>><</capture>></div>
	<</if>>
	<div class="wardrobe-grid-name"><<if _gridPanelFavorite>><<print _gridName>><<else>><<capture _gridSlot _gridIndex _gridIsWorn _gridRefreshPanel>><<link _gridName>><<if _gridIsWorn>><<wardrobePreviewRemove _gridSlot _gridRefreshPanel>><<else>><<wardrobePreviewEquip _gridSlot _gridIndex _gridRefreshPanel>><</if>><</link>><</capture>><</if>>
	</div><<if _gridIsWorn>>
	<span class="wardrobe-grid-worn-indicator" title="Click to remove">Worn</span><</if>>
	<<if _gridGender>>
	<span class="wardrobe-grid-gender no-numberify" @title="_gridGender is 'm' ? 'Male-only clothing' : 'Female-only clothing'">
		<<if $options.images is 1>>
			<<if _gridGender is "m">><img src="img/misc/icon/male.png" class="male" alt="Male-only clothing"><<else>><img src="img/misc/icon/female.png" class="female" alt="Female-only clothing"><</if>>
		<<else>>
			<<if _gridGender is "m">><span class="male blue bold" aria-label="Male-only clothing">♂</span><<else>><span class="female pink bold" aria-label="Female-only clothing">♀</span><</if>>
		<</if>>
	</span>
	<</if>>
	<div class="wardrobe-grid-preview"><div class="wardrobe-grid-icon clothing-icon"><<clothingicon _gridItem _gridSlot>>
	</div><<wardrobeGridIndicators _gridItem _gridSlot>>
	</div><div class="wardrobe-grid-traits"><<if Array.isArray(_gridItem.type) and _gridItem.type.length gt 0>>
	<<for _trait range _gridItem.type>>
	<<clothingtrait _trait>>
	<</for>>
	<</if>>
	</div><<wardrobeGridTooltip _gridItem _gridSlot _gridIsWorn>>
	</div><</widget>>
<<widget "wardrobeGridTooltip">>
	<<set _tooltipItem to _args[0]>>
	<<set _tooltipSlot to _args[1]>>
	<<set _tooltipWorn to _args[2] is true>>
	<<set _tooltipData to _tooltipItem>>
	<<if setup.clothes[_tooltipSlot]>>
		<<set _tooltipData to setup.clothes[_tooltipSlot][clothesIndex(_tooltipSlot, _tooltipItem)] || _tooltipItem>>
	<</if>>
	<div class="wardrobe-grid-tooltip" role="tooltip">
		<div class="wardrobe-grid-tooltip-title"><<print _tooltipData.name_cap || _tooltipItem.name || "Unknown item">>
	</div>
		<<if _tooltipWorn>>
	<div class="wardrobe-grid-tooltip-worn">Currently worn - click to remove.</div><<else>>
	<div class="wardrobe-grid-tooltip-worn">Click to wear.</div><</if>>
		<div class="wardrobe-grid-tooltip-meta">
			<<wardrobeGridIndicators _tooltipItem _tooltipSlot "fast">>
			<<if Array.isArray(_tooltipItem.type) and _tooltipItem.type.length gt 0>>
			<div class="wardrobe-grid-tooltip-traits">
				<<for _trait range _tooltipItem.type>>
					<<clothingtrait _trait>>
				<</for>>
			</div>
			<</if>>
		</div>
		<div class="wardrobe-grid-tooltip-description">
			<<if _tooltipItem.gender is "m">>
	<span class="lblue">For boys ♂.</span>
			<<elseif _tooltipItem.gender is "f">>
	<span class="pink">For girls ♀.</span>
			<</if>>
			<<print _tooltipData.description || "">>
		</div>
	</div>
<</widget>>

<<widget "wardrobeGridIndicators">>
	<<set _gridItem to _args[0]>>
	<<set _gridSlot to _args[1]>>
	<<set _gridFastLabels to _args[2] is "fast">>
	<<set _gridIntegrityMax to Number(clothingData(_gridSlot, _gridItem, "integrity_max")) || 0>>
	<<set _gridIntegrity to Number(_gridItem.integrity)>>
	<<if !Number.isFinite(_gridIntegrity)>>
		<<set _gridIntegrity to _gridIntegrityMax>>
	<</if>>
	<<set _gridIntegrityRatio to _gridIntegrityMax gt 0 ? Math.clamp(_gridIntegrity / _gridIntegrityMax, 0, 1) : 0>>
	<<set _gridIntInf to getIntegrityInfo(_gridIntegrityRatio * 1000)>>
	<<set _gridReveal to Number(_gridItem.reveal) || 0>>
	<<set _gridRevInf to getRevealInfo(_gridReveal)>>
	<<set _gridWarmth to Number(_gridItem.warmth) || 0>>
	<<run (() => { try { _gridWarmth = Number(getTrueWarmth(_gridItem)) || 0; } catch (e) {} })()>>
	<<set _gridWarmthInfo to getWarmthInfo(_gridWarmth * 0.5)>>
	<<set _gridIntegrityLabel to "Durability: " + _gridIntegrity + " / " + _gridIntegrityMax>>
	<<set _gridRevealLabel to "Reveal: " + _gridReveal>>
	<<set _gridWarmthLabel to "Warmth: " + _gridWarmth>>
	<div class="wardrobe-grid-statline">
		<div class="clothing-integrity" @title="_gridFastLabels ? '' : _gridIntegrityLabel" @data-hover-label="_gridFastLabels ? _gridIntegrityLabel : ''">
			<<if $options.images is 1>>
	<img class="clothing-stats-icon" src="img/ui/clothes/integrity.png"><<else>>
	<span class="clothing-stats-text">I.</span><</if>>
			<<for _j = 0; _j lt 7; _j++>>
	<span @class="'stats-ball ' + (_j < _gridIntInf[0] ? 'bg-' + _gridIntInf[1] : '')">&nbsp;</span><</for>>
		</div>
		<div class="clothing-reveal" @title="_gridFastLabels ? '' : _gridRevealLabel" @data-hover-label="_gridFastLabels ? _gridRevealLabel : ''">
			<<if $options.images is 1>>
	<img class="clothing-stats-icon" src="img/ui/clothes/reveal.png"><<else>>
	<span class="clothing-stats-text">R.</span><</if>>
			<<for _j = 0; _j lt 7; _j++>>
	<span @class="'stats-ball ' + (_j < _gridRevInf[0] ? 'bg-' + _gridRevInf[1] : '')">&nbsp;</span><</for>>
		</div>
		<div class="clothing-warmth" @title="_gridFastLabels ? '' : _gridWarmthLabel" @data-hover-label="_gridFastLabels ? _gridWarmthLabel : ''">
			<<if $options.images is 1>>
	<img class="clothing-stats-icon" src="img/ui/clothes/warmth.png"><<else>>
	<span class="clothing-stats-text">W.</span><</if>>
			<<for _j = 0; _j lt 7; _j++>>
	<span class="stats-ball" @style="(_j < _gridWarmth * 0.5 ? _gridWarmthInfo : '')">&nbsp;</span><</for>>
		</div>
	</div>
<</widget>>
<<widget "wardrobePaperDoll">>
	<<if $wardrobePreview isnot undefined and $wardrobePreview.active is true>>
	<<wardrobePreviewProjectCurrent>>
	<<wardrobePaperDollBody>>
	<<wardrobePreviewRestoreProjection>>
	<<else>>
	<<wardrobePaperDollBody>>
	<</if>>
	<</widget>>
<<widget "wardrobePaperDollBody">>
	<<set _dollLeftSlots to [{slot:"head",label:"Head"},{slot:"face",label:"Face"},{slot:"neck",label:"Neck"},{slot:"over_head",label:"Outer head"},{slot:"over_upper",label:"Outer upper"},{slot:"hands",label:"Hands"},{slot:"handheld",label:"Handheld"}]>>
	<<set _dollRightSlots to [{slot:"upper",label:"Upper"},{slot:"under_upper",label:"Under upper"},{slot:"lower",label:"Lower"},{slot:"under_lower",label:"Under lower"},{slot:"genitals",label:"Genitals"},{slot:"over_lower",label:"Outer lower"},{slot:"legs",label:"Legs"},{slot:"feet",label:"Feet"}]>>
	<div class="wardrobe-paperdoll-map"><div class="wardrobe-doll-slots wardrobe-doll-slots-left"><<for _slotInfo range _dollLeftSlots>>
	<<wardrobePaperDollSlot _slotInfo.slot _slotInfo.label>>
	<</for>>
	</div><div class="wardrobe-paperdoll-model"><div class="wardrobe-paperdoll-stage"><<if $options.images is 1>>
	<<selectmodel "main">>
	<<modelprepare-player-body>>
	<<modelprepare-player-clothes>>
	<<set _modeloptions.show_hair to true>>
	<<set _modeloptions.hair_sides_type to $wardrobePreview.current.hair.type>>
	<<set _modeloptions.hair_sides_position to $wardrobePreview.current.hair.position>>
	<<set _modeloptions.hair_sides_length to $wardrobePreview.current.hair.lengthStage>>
	<<set _modeloptions.hair_fringe_type to $wardrobePreview.current.hair.fringe>>
	<<set _modeloptions.hair_fringe_length to $wardrobePreview.current.hair.fringeLengthStage>>
	<<rendermodel "wardrobe-paperdoll-canvas">>
	<<else>>
	<div class="wardrobe-paperdoll-placeholder"><span>Paper doll preview</span><small>Enable images in the game options to display it.</small></div><</if>>
	</div></div><div class="wardrobe-doll-slots wardrobe-doll-slots-right"><<for _slotInfo range _dollRightSlots>>
	<<wardrobePaperDollSlot _slotInfo.slot _slotInfo.label>>
	<</for>>
	</div></div>
	<</widget>>
<<widget "wardrobePaperDollSlot">>
	<<set _dollSlot to _args[0]>>
	<<set _dollLabel to _args[1]>>
	<<set _dollWorn to ($wardrobePreview isnot undefined and $wardrobePreview.active is true) ? $wardrobePreview.current.worn : $worn>>
	<<set _dollItem to _dollWorn[_dollSlot]>>
	<<set _dollComboLocked to window.wardrobeIsComboLowerLocked(_dollWorn, _dollSlot)>>
	<<if _dollItem and _dollItem.name isnot "naked">>
	<<set _dollName to (_dollItem.name_cap || _dollItem.name || "").toUpperFirst()>>
	<div @class="'wardrobe-doll-slot wardrobe-doll-slot-filled no-numberify' + (_dollComboLocked ? ' wardrobe-doll-slot-combo-locked' : ' wardrobe-action')" @aria-disabled="_dollComboLocked ? 'true' : 'false'" @title="_dollComboLocked ? 'Remove ' + window.wardrobeComboPrimaryName(_dollWorn, _dollSlot) + ' before changing the ' + _dollLabel.toLowerCase() + ' clothing' : 'Open ' + _dollLabel + ' clothing options'"><div class="wardrobe-doll-slot-label"><<print _dollLabel>>
	</div><div class="wardrobe-doll-slot-name"><<print _dollName>>
	</div><div class="wardrobe-doll-slot-content"><span class="wardrobe-doll-slot-icon clothing-icon"><<clothingicon _dollItem _dollSlot>>
	</span></div><<if _dollComboLocked>><div class="wardrobe-doll-slot-combo-hatch" aria-hidden="true"></div><<else>><div class="wardrobe-doll-slot-action no-numberify"><<capture _dollSlot _dollLabel>><<link " ">><span class="wardrobe-doll-slot-sr-label">Open <<print _dollLabel >> clothing options</span><<wardrobeClothingOpenSlot _dollSlot>><</link>><</capture>></div><</if>></div><<else>>
	<div class="wardrobe-doll-slot wardrobe-doll-slot-empty" @title="'Open ' + _dollLabel + ' clothing options'"><div class="wardrobe-doll-slot-label"><<print _dollLabel>>
	</div><span class="wardrobe-doll-slot-empty-text">Empty</span><div class="wardrobe-doll-slot-action no-numberify"><<capture _dollSlot _dollLabel>><<link " ">><span class="wardrobe-doll-slot-sr-label">Open <<print _dollLabel>> clothing options</span><<wardrobeClothingOpenSlot _dollSlot>><</link>><</capture>></div></div><</if>>
	<</widget>>
<<widget "wardrobeDollRemove">>
	<<wardrobePreviewRemove _args[0]>>
	<</widget>>
<<widget "backpackInventory">>
	<div id="backpackInventoryPanel" class="backpack-inventory">
		<<set _backpack to window.handheldInventoryActive()>>
		<<set _locationKey to V.location || "home">>
		<<set _locationBucket to window.locationInventoryEnsure().locations[_locationKey]>>
		<<if !_backpack>>
			<div class="backpack-inventory-empty">You are not wearing a bookbag. Items here must be collected while carrying a bookbag.</div>
		<<else>>
			<<set _inventory to window.ensureHandheldInventory(_backpack)>>
			<<set _occupied to _inventory.slots.filter(item => item != null).length>>
			<div class="backpack-inventory-header"><div class="backpack-inventory-title"><<print _backpack.name_cap || _backpack.name>></div><div class="backpack-inventory-count"><<print _occupied>> / <<print _inventory.slots.length>> slots occupied</div></div>
			<div class="backpack-grid" role="list">
				<<for _i = 0; _i lt _inventory.slots.length; _i++>>
					<<set _item to _inventory.slots[_i]>>
					<div class="backpack-slot" role="listitem"><span class="backpack-slot-number">Slot <<print _i + 1>></span>
					<<if _item isnot null>><div class="backpack-slot-item"><<print window.locationInventoryLabel(_item) || window.handheldInventoryItemLabel(_item)>></div><<capture _backpack _i>><<link "Remove">><<run window.handheldInventoryRemove(_backpack, _i)>><<replace "#backpackInventoryPanel">><<backpackInventory>><</replace>><</link>><</capture>>
					<<else>><div class="backpack-slot-empty">Empty</div><</if>></div>
				<</for>>
			</div>
		<</if>>
		<section class="backpack-location-pile"><h3>Stored at <<print _locationKey>></h3>
			<<if _locationBucket.items.length>><<for _j = 0; _j lt _locationBucket.items.length; _j++>><<capture _locationKey _j>><div class="backpack-location-item"><span><<print window.locationInventoryLabel(_locationBucket.items[_j])>></span><<if _backpack and _inventory.slots.includes(null)>><<link "Collect">><<run window.locationInventoryTake(_locationKey, _j, false)>><<replace "#backpackInventoryPanel">><<backpackInventory>><</replace>><</link>><<else>><span class="backpack-recover-disabled">No free slot</span><</if>></div><</capture>><</for>><<else>>No ordinary items stored here.<</if>>
		</section>
		<section class="backpack-forced-overflow"><h3>Forced event overflow</h3><p>These items cannot be used until collected into a backpack.</p>
			<<if _locationBucket.forcedOverflow.length>><<for _k = 0; _k lt _locationBucket.forcedOverflow.length; _k++>><<capture _locationKey _k>><div class="backpack-location-item"><span><<print window.locationInventoryLabel(_locationBucket.forcedOverflow[_k])>></span><<if _backpack and _inventory.slots.includes(null)>><<link "Recover">><<run window.locationInventoryTake(_locationKey, _k, true)>><<replace "#backpackInventoryPanel">><<backpackInventory>><</replace>><</link>><<else>><span class="backpack-recover-disabled">Unavailable</span><</if>></div><</capture>><</for>><<else>>No forced overflow items.<</if>>
		</section>
	</div>
<</widget>>
<<widget "wardrobeLinks">>
	<<set _wardrobeLinks=[
		{ id: 'over_head', label: 'Over Head', disabled: !$debug },
		{ id: 'over_upper', label: 'Over Upper', disabled: !$debug },
		{ id: 'over_lower', label: 'Over Lower', disabled: !$debug },
		{ id: 'head', label: 'Head' },
		{ id: 'face', label: 'Face' },
		{ id: 'neck', label: 'Neck' },
		{ id: 'upper', label: 'Upper' },
		{ id: 'lower', label: 'Lower' },
		{ id: 'under_upper', label: 'Under Upper' },
		{ id: 'under_lower', label: 'Under Lower' },
		{ id: 'hands', label: 'Hands' },
		{ id: 'handheld', label: 'Handheld' },
		{ id: 'legs', label: 'Legs' },
		{ id: 'feet', label: 'Feet' },
	]>>
	<<for _i = 0; _i < _wardrobeLinks.length; _i++>>
		<<set _wardrobeLink=_wardrobeLinks[_i]>>
		<<if !_wardrobeLink.disabled>>
			<a
				@class="($lastWardrobeSlot is _wardrobeLink.id ? 'selected' : '')"
				@id="Dynamic.eventBinder(_wardrobeLink.id)"
				onclick="(id) => $lastWardrobeSlot = id"
			>_wardrobeLink.label</a><<if _i < _wardrobeLinks.length - 1>> | <</if>>
		<</if>>
	<</for>>
<</widget>>

<<widget "wardrobeClothingOptions">>
	<br>
	<<if $wardrobeOption is undefined or $wardrobeOption is 0>><<set $wardrobeOption to "wear">><</if>>
	<<if $wardrobeRepeat isnot true or ($wardrobeOption is "repair" and $location isnot "home")>><<set $wardrobeOption to "wear">><</if>>

	<label><<radiobutton "$wardrobeOption" "wear" autocheck>> Wear</label> |
	<label><<radiobutton "$wardrobeOption" "delete" autocheck>> Discard</label> |
	<<if $sewingKit is 1 and $location is "home">>
		<label><<radiobutton "$wardrobeOption" "repair" autocheck>> Repair (0:05 per piece)</label> |
	<</if>>
	<label><<radiobutton "$wardrobeOption" "separateOutfits" autocheck>> Separate Outfits (0:10)</label> |
	<<if $settings.multipleWardrobes and $wardrobes[$wardrobe_location].transfer && Object.values($wardrobes).filter(w => w.unlocked && w.shopSend).length > 1>>
		<label><<radiobutton "$wardrobeOption" "transfer" autocheck>> Transfer:</label>
		<<set _options to {}>>
		<<for _label, _value range $wardrobes>>
			<<if _value.unlocked and _label isnot $wardrobe_location and $wardrobes[_label].shopSend>>
				<<if _value.name is "Mansion Wardrobe" and ["kicked", "fallen"].contains($avery_fate)>>
					<<set _value.name to "Storage Unit">>
				<</if>>
				<<set _options[_value.name] to _label>>
			<</if>>
		<</for>>
		<<listbox "_wardrobeTransfer" autoselect>>
			<<optionsfrom _options>>
		<</listbox>>
		|
	<</if>>

	<label><<checkbox "$wardrobeRepeat" false true autocheck>> Repeat Actions</label>

	<<if $wardrobeOption is "delete" and $wardrobeRepeat is true>>
		<h2 class="red">Discard On Repeat</h2>
	<<else>>
		<br><br>
	<</if>>
<</widget>>

<<widget "wardrobeNewOutfit">>
  <<set _previewWorn to ($wardrobePreview isnot undefined and $wardrobePreview.active is true) ? $wardrobePreview.current.worn : $worn>>
	<br>
	Add new set:
	<br>
	Name: <input id="outfitName" type="text" value="Custom" maxlength="30" onfocus="V.tempDisable = true;">
	<br>
	Type:
	<<listbox "$outfit_type">>
		<<option "Normal" 0 selected>>
		<<option "Sleep" "sleep">>
		<<option "Swimming" "swim">>
		<<option "School" "school">>
	<</listbox>>
	<br>
	<label>
		Save Clothes Colours in Set
		<<checkbox "_saveColor" false true autocheck>>
	</label>
	<br>
	<<if $settings.multipleWardrobes>>
		<label>
			Make clothes set unique to this wardrobe
			<<checkbox "_saveLocation" false true autocheck>>
		</label>
		<br>
	<</if>>
	<<if $savedHairStyles>>
		<div>
			<<set _savedHairStylesKeys to Object.keys($savedHairStyles)>>
			Hair Style:
			<<listbox "_hairStyle" autoselect>>
				<<option "Not set" undefined>>
				<<optionsfrom _savedHairStylesKeys>>
			<</listbox>>
			<mouse class="tooltip linkBlue">(?)<span>'Not set' will not change the current hairstyle.</span></mouse>
		</div>
	<<else>>
		<div>
			Hair Style: No sets saved (Check mirror)
		</div>
	<</if>>
	<br>
	<div class="wardrobe-action">
		<<link "Add current clothes as new set">>
			<<set $outfit_name to document.getElementById("outfitName").value.replace(/[^a-zA-Z\u4e00-\u9fa5 0-9.!()]+/g,"")>>
			<<set _newOutfit to {
				index: $outfit.length,
				name: $outfit_name,
				over_upper: clone(_previewWorn.over_upper.name),
				over_lower: clone(_previewWorn.over_lower.name),
				upper: clone(_previewWorn.upper.name),
				lower: clone(_previewWorn.lower.name),
				under_upper: clone(_previewWorn.under_upper.name),
				under_lower: clone(_previewWorn.under_lower.name),
				over_head: clone(_previewWorn.over_head.name),
				head: clone(_previewWorn.head.name),
				face: clone(_previewWorn.face.name),
				neck: clone(_previewWorn.neck.name),
				hands: clone(_previewWorn.hands.name),
				handheld: clone(_previewWorn.handheld.name),
				legs: clone(_previewWorn.legs.name),
				feet: clone(_previewWorn.feet.name),
				genitals: clone(_previewWorn.genitals.name),
				type: ["normal"],
				colors: false,
			}>>
			<<if $outfit_name is "" or $outfit_name is "Custom">><<set $outfit_name to "Custom " + $outfit.length>><</if>>
			<<set _newOutfit.name to $outfit_name>>
			<<if $outfit_type>>
				<<set _newOutfit.type[0] to $outfit_type>>
			<</if>>

			<<set _equip to ["over_upper", "over_lower", "upper", "lower", "under_upper", "under_lower", "over_head", "head", "face", "neck", "hands", "handheld", "legs", "feet"]>>
			<<if _saveColor>>
				<<set _colors to {}>>
				<<for _slot range _equip>>
					<<set _colors[_slot] to [_previewWorn[_slot].colour, _previewWorn[_slot].accessory_colour]>>
					<<if _previewWorn[_slot].colour is "custom" or _previewWorn[_slot].accessory_colour is "custom">>
						<<set _colors[_slot+"custom"] to [_previewWorn[_slot].colourCustom, _previewWorn[_slot].accessory_colourCustom]>>
					<</if>>
					<<if _previewWorn[_slot].pattern isnot undefined>>
						<<set _colors[_slot].push(_previewWorn[_slot].pattern)>>
					<</if>>
				<</for>>
				<<set _newOutfit.colors to _colors>>
			<<else>>
				<<set _newOutfit.colors to false>>
			<</if>>
			<<set _positions to {}>>
			<<for _slot range _equip>>
				<<if _previewWorn[_slot].altposition>>
					<<set _positions[_slot] to _previewWorn[_slot].altposition>>
				<</if>>
				<<if _previewWorn[_slot].altsleeve>>
					<<set _positions.sleeves to _previewWorn[_slot].altsleeve>>
				<</if>>
			<</for>>
			<<if Object.keys(_positions).length > 0>>
				<<set _newOutfit.positions to _positions>>
			<</if>>
			<<if _saveLocation>>
				<<set _newOutfit.location to $wardrobe_location>>
			<</if>>
			<<if _hairStyle>>
				<<set _newOutfit.hairStyle to _hairStyle>>
			<<run syncOutfitItemIds(_newOutfit)>>
			<</if>>
			<<set $outfit.push(_newOutfit)>>
			<<updatewardrobe "outfits">>
		<</link>>
	</div>
<</widget>>

<<widget "wardrobeintegrity">><<silently>>
	<<set _eIndextem to _args[0]>>
	<<set _eIndexntegrityMax to clothingData(_args[1],_eIndextem,'integrity_max')>>
	<<if _eIndextem.integrity gt (_eIndexntegrityMax * 9 / 10)>>
		<<set $_output to "">>
	<<elseif _eIndextem.integrity gt (_eIndexntegrityMax * 5 / 10)>>
		<<set $_output to "<span>(frayed)</span>">>
	<<elseif _eIndextem.integrity gt (_eIndexntegrityMax * 2 / 10)>>
		<<set $_output to "<span>(torn)</span>">>
	<<else>>
		<<set $_output to "<span>(tattered)</span>">>
	<</if>>
<</silently>><<print $_output>><</widget>>

<<widget "toggleHoodLink">>
	<div class="toggleHoodLink">
		<<link `($worn.upper.hoodposition is "down" ? "Pull hood up" : "Pull hood down")`>>
			<<toggleHood _args[0]>>
			<<updatesidebarimg>>
			<<if _args[0] isnot "shop">>
				<<updatewardrobe>>
			<</if>>
			<<run $(".toggleHoodLink .link-internal").html($worn.upper.hoodposition is "down" ? "Pull hood up" : "Pull hood down")>>
			<<run Links.generateLinkNumbers($(".passage"))>>
		<</link>>
	</div>
<</widget>>

<<widget "toggleHood">>
	/* If hood is up, put it down and free up the head slot*/
	<<if $worn.upper.hoodposition is "up" and $worn.head.hood is 1 and $worn.upper.outfitPrimary.head is $worn.head.name>>
		<<run delete $worn.upper.outfitPrimary.head>>
		<<set $worn.upper.hoodposition to "down">>
		<<if _args[0] is "shop" and $tryOn.ownedStored.head.name isnot $worn.head.name and !($tryOn.ownedStored.head.outfitSecondary and $tryOn.ownedStored.head.outfitSecondary[1] isnot "broken" and $tryOn.ownedStored.head.outfitSecondary[1] isnot "split")>>
			<<set $worn.head to clone($tryOn.ownedStored.head)>>
		<<else>>
			<<set $worn.head to clone(setup.clothes.head[0])>>
		<</if>>

		<<if _args[0] is "shop" and $tryOn.tryingOn.upper is null>>
			<<updateOwned "upper">>
			<<updateOwned "head">>
		<</if>>

	/* If hood is down, put it back up and remove anything on the head if necessary */
	<<elseif $worn.upper.hoodposition is "down">>
		<<if !$worn.head.cursed>> /* No cursed head items yet, but if one is made, should probably have some popup saying this was prevented */
			<<if $worn.head.outfitSecondary and $worn.head.outfitSecondary[1] isnot "broken" and $worn.head.outfitSecondary[1] isnot "split">>
				<<if $worn.head.hood is 1 and $worn.head.outfitSecondary[1] is $worn.upper.name and
				$worn.head.colour is $worn.upper.colour and $worn.head.accessory_colour is $worn.upper.accessory_colour and
				$worn.head.colourCustom is $worn.upper.colourCustom and $worn.head.accessory_colourCustom is $worn.upper.accessory_colourCustom>>
					<<set $worn.upper.outfitPrimary.head to clone(setup.clothes.upper[$worn.upper.index].outfitPrimary.head)>>
					<<set $worn.upper.hoodposition to "up">>
				<</if>>
			<<else>>
				<<if _args[0] is "shop">> /*If in a shop, make sure the head item is accounted for first*/
					<<if $tryOn.tryingOn.head isnot null>>
						<<shopbuyv2 "head" "return" null>>/*return if trying on*/
					<</if>>
					<<if $tryOn.tryingOn.upper is null and $worn.head.name isnot "naked">>
						<<generalUndress $wardrobe_location "head">>/*send back to wardrobe if already owned*/
					<</if>>
				<<elseif $worn.head.name isnot "naked">>
					<<generalUndress $wardrobe_location "head">>
				<</if>>
				<<set $worn.upper.outfitPrimary.head to clone(setup.clothes.upper[$worn.upper.index].outfitPrimary.head)>>
				<<set $worn.upper.hoodposition to "up">>
				/* re-create the hood using colors from the hoodie */
				<<set $_hoodIndex to setup.clothes.head.findIndex(x => x.name === $worn.upper.outfitPrimary.head)>>
				<<set $worn.head to clone(setup.clothes.head[$_hoodIndex])>>
				<<set $worn.head.colour to $worn.upper.colour>>
				<<if $worn.head.colour is "custom">>
					<<set $worn.head.colourCustom to $worn.upper.colourCustom>>
				<</if>>
				<<set $worn.head.accessory_colour to $worn.upper.accessory_colour>>
				<<if $worn.head.accessory_colour is "custom">>
					<<set $worn.head.accessory_colourCustom to $worn.upper.accessory_colourCustom>>
				<</if>>

				<<if _args[0] is "shop" and $tryOn.tryingOn.upper is null>>
					<<updateOwned "upper">>
				<</if>>
			<</if>>
		<</if>>
	<<elseif $worn.upper.hoodposition is undefined and setup.clothes.upper[$worn.upper.index].hoodposition isnot undefined>>
		<<set $worn.upper.hoodposition to "up">>
	<</if>>
<</widget>>

<<widget "toggleUpperTuck">>
	<<set _linkOption1 to _args[0] || `Untuck from ${$worn.lower.name}`>>
	<<set _linkOption2 to _args[1] || `Tuck into ${$worn.lower.name}`>>
	<div class="toggleUpperTuck">
		<<link `($upperTucked ? _linkOption1 : _linkOption2)`>>
			<<set $upperTucked to +!$upperTucked>>
			<<updatesidebarimg>>
			<<run $(".toggleUpperTuck .link-internal").html($upperTucked ? _linkOption1 : _linkOption2)>>
			<<run Links.generateLinkNumbers($(".passage"))>>
		<</link>>
	</div>
<</widget>>

<<widget "toggleLowerTuck">>
	<<set _linkOption1 to _args[0] || `Untuck from ${$worn.feet.name}`>>
	<<set _linkOption2 to _args[1] || `Tuck into ${$worn.feet.name}`>>
	<div class="toggleLowerTuck">
		<<link `($lowerTucked ? _linkOption1 : _linkOption2)`>>
			<<set $lowerTucked to +!$lowerTucked>>
			<<updatesidebarimg>>
			<<run $(".toggleLowerTuck .link-internal").html($lowerTucked ? _linkOption1 : _linkOption2)>>
			<<run Links.generateLinkNumbers($(".passage"))>>
		<</link>>
	</div>
<</widget>>


<<widget "toggleBellyTuck">>
	<<set _softOption1 to _args[0] || `Tug down your ${$worn.lower.name}`>>
	<<set _softOption2 to _args[1] || `Pull up your ${$worn.lower.name}`>>
	<div class="toggleBellyTuck">
		<<link `($bellyTucked ? _softOption1 : _softOption2)`>>
			<<set $bellyTucked to +!$bellyTucked>>
			<<updatesidebarimg>>
			<<run $(".toggleBellyTuck .link-internal").html($bellyTucked ? _softOption1 : _softOption2)>>
			<<run Links.generateLinkNumbers($(".passage"))>>
		<</link>>
	</div>
<</widget>>

<<widget "toggleLeash">>
	<<if ["collar", "free use collar", "leather collar", "spiked collar"].includes($worn.neck.name)>>
		<<link "Attach Leash">>
			<<attach_leash true true>>
			<<updatesidebarimg>>
			<<replace "#wardrobeLeash">><<toggleLeash>><</replace>>
		<</link>>
	<<elseif ["collar with leash", "free use collar with leash", "leather collar with leash", "spiked collar with leash"].includes($worn.neck.name)>>
		<<link "Detach Leash">>
			<<detach_leash true true>>
			<<updatesidebarimg>>
			<<replace "#wardrobeLeash">><<toggleLeash>><</replace>>
		<</link>>
	<</if>>
<</widget>>

<<widget "toggleAltLink">><<silently>>
	<<switch _args[0]>>
		<<case "upper">>
			<<switch $worn.upper.variable>>
				<<case "schoolcardigan">><<set _altLink to ["Tie cardigan around waist", "Wear cardigan normally"]>>
				<<case "brownleather" "blackleather" "leathercropjacket" "winterjacket">><<set _altLink to ["Zip jacket", "Unzip jacket"]>>
				<<case "waistcoat" "waistcoatlapel" "blazershirt">><<set _altLink to ["Tuck in", "Untuck"]>>
				<<case "dress" "buttondown" "oversizedbuttondown" "shortsleevebuttonup" "flannel shirt">><<set _altLink to ["Unbutton shirt", "Button up shirt"]>>
				<<case "catsuit">><<set _altLink to ["Unzip", "Zip"]>>
				<<case "kimono" "kimonomini">><<set _altLink to ["Loosen", "Tighten"]>>
				<<case "flowy sleeve top" "milkmaid dress">><<set _altLink to ["Pull sleeves down", "Pull sleeves up"]>>
				/*<<case "striped sweater">><<set _altLink to ["Roll up the sleeves", "Roll down the sleeves"]>>*/
				<<default>><<exit>>
			<</switch>>
		<<case "under_upper">>
			<<switch $worn.under_upper.variable>>
				<<case "ruffled swimsuit">><<set _altLink to ["Take off cardigan", "Put on cardigan"]>>
				<<default>><<exit>>
			<</switch>>
		<<case "head">>
			<<switch $worn.head.variable>>
				<<case "bandana hat">><<set _altLink to ["Tie at the back", "Tie at the front"]>>
				<<default>><<exit>>
			<</switch>>
		<<case "neck">>
			<<switch $worn.neck.variable>>
				<<case "suspenders">><<set _altLink to ["Lower suspenders", "Wear suspenders normally"]>>
				<<case "tie">><<set _altLink to ["Loosen", "Tighten"]>>
				<<default>><<exit>>
			<</switch>>
		<<case "face">>
			<<if $worn.face.type.includes("cool") or $worn.face.type.includes("glasses")>>
				<<switch $worn.face.variable>>
					<<case "monocle">><<set _altLink to ["Cover left eye", "Cover right eye"]>>
					<<default>><<set _altLink to ["Push on head", "Wear normally"]>>
				<</switch>>
			<<else>>
				<<switch $worn.face.variable>>
					<<case "medical eyepatch" "eyepatch" "rose eyepatch" "butterfly eyepatch">><<set _altLink to ["Cover left eye", "Cover right eye"]>>
					<<case "plaster">><<set _altLink to ["Cover left cheek", "Cover right cheek"]>>
					<<case "swimgoggles">><<set _altLink to ["Push on head", "Wear normally"]>>
					<<case "sleeping mask">><<set _altLink to ["Night time", "Day time"]>>
					<<default>><<exit>>
				<</switch>>
			<</if>>
		<<case "legs">>
			<<switch $worn.legs.variable>>
				<<case "kneeplaster">><<set _altLink to ["Cover left knee", "Cover right knee"]>>
				<<default>><<exit>>
			<</switch>>
		<<default>><<exit>>
	<</switch>>
	<</silently>>
	<span @class="_args[0]">
		<<capture _args[0] _altLink>>
			<<link `($worn[_args[0]].altposition is "none" ? _altLink[0] : _altLink[1])`>>
				<<toggleAltPosition _args[0]>>
				<<updatesidebarimg>>
				<<if _args[1] is "wardrobe">>
					<<updatewardrobe>>
				<</if>>
				<<run $(".toggleAltLink ." + _args[0] + " .link-internal").html($worn[_args[0]].altposition is "none" ? _altLink[0] : _altLink[1])>>
				<<run Links.generateLinkNumbers($(".passage"))>>
			<</link>>
		<</capture>>
	</span>
<</widget>>

<<widget "toggleAltPosition">>
	/*Changes sprite to an alternate image*/
	<<if $worn[_args[0]].altposition is undefined and setup.clothes[_args[0]][$worn[_args[0]].index].altposition isnot undefined>>
		<<set $worn[_args[0]].altposition to "none">>
	<<else>>
		<<set $worn[_args[0]].altposition to ($worn[_args[0]].altposition is "none" ? "alt" : "none")>>
	<</if>>
<</widget>>

<<widget "toggleAltSleeve">>
	<<set _inDefaultState to _args[0] || "Roll up sleeves">>
	<<set _inAltState to _args[1] || "Unroll sleeves">>
	<div class="toggleAltSleeve">
		<<link `($worn.upper.altsleeve is "none" ? _inDefaultState : _inAltState)`>>
			<<set $worn.upper.altsleeve to ($worn.upper.altsleeve is "none" ? "alt" : "none")>>
			<<updatesidebarimg>>
			<<run $(".toggleAltSleeve .link-internal").html($worn.upper.altsleeve is "none" ? _inDefaultState : _inAltState)>>
			<<run Links.generateLinkNumbers($(".passage"))>>
		<</link>>
	</div>
<</widget>>

<<widget "toggleFaceLayer">>
	/*changes z-index */
	<<set _linkOption1 to "Move hair in front">>
	<<set _linkOption2 to "Tuck hair behind">>
	<div class="toggleFaceLayer">
		<<link `($facelayer is "front" ? _linkOption2 : _linkOption1)`>>
			<<set $facelayer to ($facelayer is "front" ? "back" : "front")>>
			<<updatesidebarimg>>
			<<if _args[0] is "wardrobe">>
					<<updatewardrobe>>
			<</if>>
			<<run $(".toggleFaceLayer .link-internal").html($facelayer is "front" ? _linkOption2 : _linkOption1)>>
			<<run Links.generateLinkNumbers($(".passage"))>>
		<</link>>
	</div>
	<br>
<</widget>>

<<widget "wardrobeList">>
	<<wardrobeClothingOptions>>
	<<set _wardrobe_list to _args[0]>>
	<<if !Object.keys($worn).includes(_wardrobe_list)>>
		An error occurred to 'widget "wardrobeList"', please report if you did not edit the save data manually in any way.
	<<else>>
		<<set _wear to "wear_"+_wardrobe_list>>

		<<set _outfitTypes to setup.clothingLayer.torso_inner>>
		<<set _loweroutfitCheck to setup.clothingLayer.lower>>

		__<<print _wardrobe_list[0].toUpperCase() + _wardrobe_list.substring(1)>>__ <i>_selectedWardrobe[_wardrobe_list].length / _selectedWardrobe.space</i>
		<<if _wardrobe_list is "upper">>(Outfits will also take a lower slot)<</if>>
		<<if _wardrobe_list is "under_upper">>(Outfits will also take an under lower slot)<</if>>
		<br>
		Order by:
		/*Undefined error for unknown reason*/
		/*<a @onclick="`wikifier('wardrobeListReorder', '`+ $lastWardrobeSlot + `', 'name');`">Name</a> |*/
		<div class="wardrobe-action"><a onclick="wikifier('wardrobeListReorder', V.lastWardrobeSlot, 'name');">Name</a></div> |
		<div class="wardrobe-action"><a onclick="wikifier('wardrobeListReorder', V.lastWardrobeSlot, 'color');">Colour</a></div> |
		<div class="wardrobe-action"><a onclick="wikifier('wardrobeListReorder', V.lastWardrobeSlot, 'lewd');">Lewd</a></div> |
		<div class="wardrobe-action"><a onclick="wikifier('wardrobeListReorder', V.lastWardrobeSlot, 'integrity');">Integrity</a></div> |
		<div class="wardrobe-action"><a onclick="wikifier('wardrobeListReorder', V.lastWardrobeSlot, 'warmth');">Warmth</a></div> |
		<<if _outfitTypes.includes(_wardrobe_list)>>
			<div class="wardrobe-action"><a onclick="wikifier('wardrobeListReorder', V.lastWardrobeSlot, 'outfit');">Outfit Status</a></div> |
		<</if>>
		<br>
		Inverse Order by:
		<div class="wardrobe-action"><a onclick="wikifier('wardrobeListReorder', V.lastWardrobeSlot, 'name', true);">Name</a></div> |
		<div class="wardrobe-action"><a onclick="wikifier('wardrobeListReorder', V.lastWardrobeSlot, 'color', true);">Colour</a></div> |
		<div class="wardrobe-action"><a onclick="wikifier('wardrobeListReorder', V.lastWardrobeSlot, 'lewd', true);">Lewd</a></div> |
		<div class="wardrobe-action"><a onclick="wikifier('wardrobeListReorder', V.lastWardrobeSlot, 'integrity', true);">Integrity</a></div> |
		<div class="wardrobe-action"><a onclick="wikifier('wardrobeListReorder', V.lastWardrobeSlot, 'warmth', true);">Warmth</a></div> |
		<<if _outfitTypes.includes(_wardrobe_list)>>
			<div class="wardrobe-action"><a onclick="wikifier('wardrobeListReorder', V.lastWardrobeSlot, 'outfit', true);">Outfit Status</a></div> |
		<</if>>
		<br><br>
		Currently equipped:
		<<if $worn[_wardrobe_list].name is "naked">>
			nothing
			<br>
		<<else>>
			<<set _wornItem to $worn[_wardrobe_list]>>
			<<set _wornItemData to setup.clothes[_wardrobe_list][clothesIndex(_wardrobe_list,_wornItem)]>>
			<<clothingicon _wornItem _wardrobe_list>>
			<<print _wornItemData.name_cap>>
			<<if _wornItem.colour and _wornItem.colour isnot 0>>
				<span @class="_wornItem.colour?.replace(' ','-')">
					<<if _wornItem.pattern and ![0, "plain"].includes(_wornItem.pattern) and _wornItemData.pattern_options?.length gt 1>>
						(_wornItem.colour _wornItem.pattern)
					<<else>>
						(_wornItem.colour)
					<</if>>
				</span>
			<<elseif _wornItem.pattern and _wornItem.pattern isnot 0 and _wornItemData.pattern_options?.length gt 1>>
				<span @class="_wornItem.pattern?.replace(' ','-')">(_wornItem.pattern)</span>
			<</if>>
			<<if _wornItem.outfitPrimary isnot undefined>>
				<<set _keys to Object.keys(_wornItem.outfitPrimary)>>
				<<set _broken to 0>>
				<<for _j to 0; _j lt _keys.length; _j++>>
					<<if _wornItem.outfitPrimary[_keys[_j]] is "broken">>
						<<set _broken++>>
					<</if>>
				<</for>>
				<<if _broken is 0>>
						<span class="gold">(Outfit)</span>
				<<elseif _broken lt _keys.length>>
						<span class="red">(Partly Broken)</span>
				<<else>>
						<span class="red">(Broken)</span>
				<</if>>
				<<if _wornItem.one_piece is "split">>
						<span class="separated-indicator">(Separated)</span>
				<</if>>
			<</if>>
			<<if _wornItem.outfitSecondary isnot undefined>>
				<<if _wornItem.outfitSecondary[1] is "broken">>
					<span class="red">(Broken)</span>
				<<else>>
					<span class="gold">(Outfit)</span>
					<<if _wornItem.one_piece is "split">>
						<span class="separated-indicator">(Separated)</span>
					<</if>>
				<</if>>
			<</if>>
			<<wardrobeintegrity _wornItem _wardrobe_list>>
			<a onclick="document.getElementById('wardrobeItemDetails').classList.toggle('hidden')">Extra Info</a>
			<br>
			<div id="wardrobeItemDetails" @class="$wardrobeDefaults.extraInfo?'':'hidden'">
				<<if _wornItem.plural is 1>>
					<<integrity `clothingData(_wardrobe_list,_wornItem,'integrity_max')` "cap">>
				<<else>>
					A <<integrity `clothingData(_wardrobe_list,_wornItem,'integrity_max')`>>
				<</if>>
				and <<reveal _wornItem.reveal>> <<print _wornItem.name>>.

				<<if _wornItem.gender is "m">>
					<span class="lblue">For boys ♂.</span>
				<<elseif _wornItem.gender is "f">>
					<span class="pink">For girls ♀.</span>
				<</if>>
				<<print _wornItemData.description>>
				<br>
				<<print setup.WeatherDescriptions.clothingWarmth(getTrueWarmth(_wornItem))>>
				<br><br>
				<<set _temp_choice to $worn[_wardrobe_list]>>
				<<shoptraits>>
			</div>

			<<if isConnectedToHood(_wardrobe_list)>>
				<!-- If selected item is a hood or selected item has a secondary hood piece -->
				<div class="no-numberify"><<toggleHoodLink>></div>
			<</if>>
			<<if _wardrobe_list is "upper" and $worn.lower.name isnot "naked" and !_wornItemData.notuck and V.worn.upper.outfitPrimary is undefined>>
				<div class="no-numberify"><<toggleUpperTuck>></div>
			<<elseif _wardrobe_list is "lower" and $worn.feet.name isnot "naked" and !_wornItemData.notuck and !setup.clothes.feet[clothesIndex("feet",$worn.feet)].notuck>>
				<div class="no-numberify"><<toggleLowerTuck>></div>
			<</if>>
			<<if _wardrobe_list is "lower" and $player.bodyshape is "soft" and $worn.lower.name isnot "naked" and (!setup.clothes.lower[clothesIndex("lower",$worn.lower)].outfitSecondary or setup.clothes.lower[clothesIndex("lower",$worn.lower)]?.outfitSecondary[1] isnot $worn.upper.name)>>
				<div class="no-numberify"><<toggleBellyTuck>></div>
			<</if>>
			<<if _wardrobe_list is "upper" and $worn.upper.name isnot "naked" and _wornItemData.altsleeve>>
				<div class="no-numberify toggleAltSleeve"><<toggleAltSleeve>></div>
			<</if>>
			<div class="no-numberify toggleAltLink"><<toggleAltLink _wardrobe_list "wardrobe">></div>
			<<if _wardrobe_list is "neck">>
				<div id="wardrobeLeash" class="no-numberify"><<toggleLeash>></div>
			<</if>>
			<<if _wardrobe_list is "face">>
				<div class="no-numberify toggleAltLink"><<toggleFaceLayer "wardrobe">></div>
			<</if>>
		<</if>>
		<br>
		<<if $worn[_wardrobe_list].name isnot "naked">>
			<div class="wardrobeItem wardrobe-action no-numberify"><<wearlink_norefresh "Strip" 'strip'>></div>
		<</if>>
		<<if _wardrobe_list is "upper">>
			<div class="wardrobeItem wardrobe-action no-numberify"><<wearlink_norefresh "Large towel" 'large_towel'>></div>
		<</if>>
		<<if _wardrobe_list is "upper" or _wardrobe_list is "lower">>
			<div class="wardrobeItem wardrobe-action no-numberify"><<wearlink_norefresh "Towel" 'towel'>></div>
		<</if>>

		<<for _i to 0; _i lt _selectedWardrobe[_wardrobe_list].length; _i++>>
			<<set _item to _selectedWardrobe[_wardrobe_list][_i]>>
			<<set _itemData to setup.clothes[_wardrobe_list][clothesIndex(_wardrobe_list,_item)]>>
			<<if _item.outfitSecondary isnot undefined>>
				<<if _item.outfitSecondary[1] isnot "broken" and _item.outfitSecondary[1] isnot "split">>
					<<continue>>
				<</if>>
			<</if>>
			<div class="wardrobeItem wardrobe-action no-numberify">
				<<clothingicon _item _wardrobe_list>>
				<<wearlink_norefresh _itemData.name_cap _i>>
				<<if _item.gender is "m">>
					<span class="blue">♂</span>
				<<elseif _item.gender is "f">>
					<span class="pink">♀</span>
				<<else>>

				<</if>>
				<<if _item.colour and _item.colour isnot 0>>
					<span @class="_item.colour?.replace(' ','-')">
						<<if _item.pattern and ![0, "plain"].includes(_item.pattern) and _itemData.pattern_options?.length gt 1>>
							(_item.colour _item.pattern)
						<<else>>
							(_item.colour)
						<</if>>
					</span>
				<<elseif _item.pattern and _item.pattern isnot 0 and _itemData.pattern_options?.length gt 1>>
					<span @class="_item.pattern?.replace(' ','-')">(_item.pattern)</span>
				<</if>>
				<<if _item.outfitPrimary isnot undefined>>
					<<set _keys to Object.keys(_item.outfitPrimary)>>
					<<set _broken to 0>>
					<<for _j to 0; _j lt _keys.length; _j++>>
						<<if _item.outfitPrimary[_keys[_j]] is "broken">>
							<<set _broken++>>
						<</if>>
					<</for>>
					<<if _broken is 0>>
						<span class="gold">(Outfit)</span>
					<<elseif _broken lt _keys.length>>
						<span class="red">(Partly Broken)</span>
					<<else>>
						<span class="red">(Broken)</span>
					<</if>>
					<<if _item.one_piece is "split">>
						<span class="separated-indicator">(Separated)</span>
					<</if>>
				<</if>>
				<<if _item.outfitSecondary isnot undefined>>
					<<if _item.one_piece is "split">>
						<span class="separated-indicator">(Separated)</span>
					<<else>>
						<span class="red">(Broken)</span>
					<</if>>
				<</if>>
				<<wardrobeintegrity _item _wardrobe_list>>
				<<reveal _item.reveal>>
				| <span class="cold-resist-icon noDivider"><<print getTrueWarmth(_item)>></span>
				<<if $wardrobeDefaults.showTraits>>
					| <span class="wardrobe-traits noDivider"><<for _n, _trait range _item.type>>
						<<clothingtrait _trait>>
					<</for>></span>
				<</if>>
			</div>
		<</for>>
		<div style="clear:both;"></div>
	<</if>>
<</widget>>

<<widget "wearlink_norefresh">>
	<<capture _args[1] _args[2]>>
		<<link _args[0]>>
			<<if _args[2]>>
				<<set V[_args[2]] = _args[1]>>
			<<else>>
				<<set V[_wear] = _args[1]>>
			<</if>>
			<<updatewardrobe undefined _args[2]>>
		<</link>>
	<</capture>>
<</widget>>

<<widget "updatewardrobe">>
	<<if $wardrobePreview isnot undefined and $wardrobePreview.active is true>>
		<<wardrobePreviewRefresh>>
	<<else>>
	<<if window.scrollY > 130>>
		<<run $('#action-popup, #wardrobewear').html(new Wikifier(null, "<<wardrobewear>>").output)>>
		<<run $('#action-popup').css('transform', 'translateY(0)'); setTimeout(() => { $('#action-popup').css('transform', 'translateY(-100%)') }, 3200);>>
	<<else>>
		<<run $('#wardrobewear').html(new Wikifier(null, "<<wardrobewear>>").output)>>
	<</if>>
	<<run $('#wardrobewear').addClass('notransition flash'); setTimeout(() => { $('#wardrobewear').removeClass('notransition flash') }, 100);>>
	<<updatesidebarimg>>
	<<updatesidebardescription>>
	<<updateallure>>
  <<updateattractivenessscale>>
  <<updateattractivenessdescription>>
	<<updatewarmthscale>>
	<<updatewarmthdescription>>
	<<if _args[0] == "outfits">>
		<<replace "#listoutfits">><<listoutfits>><</replace>>
	<</if>>
	<<replace '#clotheson'>><<clotheson>><</replace>>
	<<if $('#wardrobeList')[0]>><<replace '#wardrobeList'>><<wardrobeContents>><</replace>><</if>>
<<if $('#wardrobePaperDoll')[0]>>
  <<replace '#wardrobePaperDoll'>><<wardrobePaperDoll>><</replace>>
<</if>>
	<<if $('#wardrobeApply')[0]>><<replace "#wardrobeApply">><<wardrobeApplyChanges>><</replace>><</if>>
<<if $('#oldWardrobeListDisplay')[0]>>
		<<if _args[1]>>
			<<set $_slot to _args[1].slice(5)>>
			<<switch $_slot>>
				<<case "upper">>
					<<replace '#clothingBox-upper'>>
						<<oldWardrobeList "upper" "outfits">>
						<<oldWardrobeList "upper" "non-outfits">>
					<</replace>>
					<<replace '#clothingBox-lower'>>
						<<oldWardrobeList "lower">>
					<</replace>>
				<<case "under_upper">>
					<<replace '#clothingBox-under_upper'>>
						<<oldWardrobeList "under_upper" "outfits">>
						<<oldWardrobeList "under_upper" "non-outfits">>
					<</replace>>
					<<replace '#clothingBox-under_lower'>>
						<<oldWardrobeList "under_lower">>
					<</replace>>
				<<default>>
					<<replace `'#clothingBox-' + $_slot`>><<oldWardrobeList $_slot>><</replace>>
			<</switch>>
			<<replace '#wardrobeMinorOptions'>><<oldWardrobeMinorOptions>><</replace>>
		<<else>>
			<<replace '#oldWardrobeListDisplay'>><<oldWardrobeListDisplay>><</replace>>
		<</if>>
	<</if>>
	<<exposure>>
	<<run $('#wardrobeExits').html(new Wikifier(null, "<<wardrobeExits>>").output)>>
	<<numberify ".passage">>
	<<run updateMoment()>>
	<</if>>
<</widget>>
<<widget "oldWardrobeMinorOptions">>
	<div id="wardrobeMinorOptions">
		<<if $worn.lower.name isnot "naked" and $worn.upper.outfitPrimary is undefined and !setup.clothes.upper[clothesIndex('upper', $worn.upper)].notuck>>
			<<set $_linkOption1 to `Untuck your ${$worn.upper.name}`>>
			<<set $_linkOption2 to `Tuck your ${$worn.upper.name} into your ${$worn.lower.name}`>>
			<<toggleUpperTuck $_linkOption1 $_linkOption2>>
		<</if>>
		<<if $worn.head.hood>>
			<!-- If selected item is a hood or selected item has a secondary hood piece -->
			<<toggleHoodLink>>
		<</if>>
		<<if ["collar", "free use collar", "leather collar", "spiked collar", "collar with leash", "free use collar with leash", "leather collar with leash", "spiked collar with leash"].includes($worn.neck.name)>>
			<div id="wardrobeLeash" class="no-numberify"><<toggleLeash>></div>
		<</if>>
	</div>
<</widget>>

<<widget "oldWardrobeListDisplay">>
	<<wardrobeClothingOptions>>
	<<oldWardrobeMinorOptions>>
	<br>

	<<if $debug is 1>>
		<<oldWardrobeList "over_upper">>
		<<oldWardrobeList "over_lower">>
	<</if>>
	<div id="clothingBox-upper">
		<<oldWardrobeList "upper" "outfits">>
		<<oldWardrobeList "upper" "non-outfits">>
	</div>
	<div id="clothingBox-lower">
		<<oldWardrobeList "lower">>
	</div>
	<div id="clothingBox-under_upper">
		<<oldWardrobeList "under_upper" "outfits">>
		<<oldWardrobeList "under_upper" "non-outfits">>
	</div>
	<div id="clothingBox-under_lower">
		<<oldWardrobeList "under_lower">>
	</div>
	<<if $debug is 1>>
		<<oldWardrobeList "over_head">>
	<</if>>
	<div id="clothingBox-head"><<oldWardrobeList "head">></div>
	<div id="clothingBox-face"><<oldWardrobeList "face">></div>
	<div id="clothingBox-neck"><<oldWardrobeList "neck">></div>
	<div id="clothingBox-hands"><<oldWardrobeList "hands">></div>
	<div id="clothingBox-handheld"><<oldWardrobeList "handheld">></div>
	<div id="clothingBox-legs"><<oldWardrobeList "legs">></div>
	<div id="clothingBox-feet"><<oldWardrobeList "feet">></div>
	<div style="clear:both;"></div>
	<<wardrobeNewOutfit>>
<</widget>>

<<widget "oldWardrobeList">>
	<<set _wardrobe_list to _args[0]>>
	<<set _showType to _args[1]>>
	<<if !Object.keys($worn).includes(_wardrobe_list)>>
		An error occurred to 'widget "oldWardrobeList"', please report if you did not edit the save data manually in any way.
	<<else>>
		<<set _wear to "wear_"+_wardrobe_list>>

		<div class="clothingBox">
		__<<print _wardrobe_list[0].toUpperCase() + _wardrobe_list.substring(1) + (_showType is "outfits" ? " Outfits" : "")>>__ <i>_selectedWardrobe[_wardrobe_list].length / _selectedWardrobe.space</i>
		<br><br>
		<div>
		<ul>
		<<if $worn[_wardrobe_list].name isnot "naked">>
			<li class="no-numberify"><<wearlink_norefresh "Strip" 'strip' _wear>></li>
		<</if>>
		<<if _wardrobe_list is "upper" and _showType is "outfits">>
			<li class="no-numberify"><<wearlink_norefresh "Large towel" 'large_towel' _wear>></li>
		<</if>>
		<<if (_wardrobe_list is "upper" or _wardrobe_list is "lower") and _showType isnot "outfits">>
			<li class="no-numberify"><<wearlink_norefresh "Towel" 'towel' _wear>></li>
		<</if>>
		<<for _i to 0; _i lt _selectedWardrobe[_wardrobe_list].length; _i++>>
			<<set _item to _selectedWardrobe[_wardrobe_list][_i]>>
			<<if _item.outfitSecondary isnot undefined>>
				<<if _item.outfitSecondary[1] isnot "broken" and _item.outfitSecondary[1] isnot "split">>
					<<continue>>
				<</if>>
			<</if>>
			<<if (_item.outfitPrimary isnot undefined and _showType is "non-outfits") or (_item.outfitPrimary is undefined and _showType is "outfits")>>
				<<continue>>
			<</if>>
			<li class="no-numberify">/*<<clothingicon _item>>*/<<wearlink_norefresh setup.clothes[_wardrobe_list][clothesIndex(_wardrobe_list,_item)].name_cap _i _wear>>
			<<if _item.colour isnot 0>>
				<span @class="_item.colour?.replace(' ','-')">(_item.colour)</span>
			<</if>>
			<<wardrobeintegrity _item _wardrobe_list>>
			</li>
		<</for>>
		</ul>
		</div></div>
	<</if>>
<</widget>>

<<widget "wardrobeListReorder">>
	<<if _args[0] and _args[1]>>
		<<set _slot to _args[0]>>
		<<set _orderType to _args[1]>>
		<<set _descending to _args[2]>>

		<<set _wardrobeItems to clone(_selectedWardrobe[_slot])>>
		<<set _newWardrobeItems to []>>
		<<switch _orderType>>
		<<case "name">>
			<<set _itemNames to []>>
			<<for _i to 0; _i lt _wardrobeItems.length; _i++>>
				<<run _itemNames.pushUnique(_wardrobeItems[_i].name)>>
			<</for>>
			<<if _descending>>
				<<set _sortedItemNames to _itemNames.sort(function(a, b){return b.localeCompare(a)})>>
			<<else>>
				<<set _sortedItemNames to _itemNames.sort()>>
			<</if>>

			<<for _i to 0; _i lt _sortedItemNames.length; _i++>>
				<<for _j to 0; _j lt _wardrobeItems.length; _j++>>
					<<if _wardrobeItems[_j].name is _sortedItemNames[_i]>>
						<<run _newWardrobeItems.push(clone(_wardrobeItems[_j]))>>
					<</if>>
				<</for>>
			<</for>>
		<<case "color">>
			<<set _itemColors to []>>
			<<for _i to 0; _i lt _wardrobeItems.length; _i++>>
				<<run _itemColors.pushUnique(_wardrobeItems[_i].colour)>>
			<</for>>
			<<if _descending>>
				<<set _sortedItemColors to _itemColors.sort(function(a, b){
					if(a === 0){
						return 0;
					}
					if(b === 0){
						return 0;
					}
					return b.localeCompare(a);
				})>>
			<<else>>
				<<set _sortedItemColors to _itemColors.sort()>>
			<</if>>

			<<for _i to 0; _i lt _sortedItemColors.length; _i++>>
				<<for _j to 0; _j lt _wardrobeItems.length; _j++>>
					<<if _wardrobeItems[_j].colour is _sortedItemColors[_i]>>
						<<run _newWardrobeItems.push(clone(_wardrobeItems[_j]))>>
					<</if>>
				<</for>>
			<</for>>
		<<case "integrity">>
			<<set _itemIntegrity to []>>
			<<for _i to 0; _i lt _wardrobeItems.length; _i++>>
				<<run _itemIntegrity.pushUnique((_wardrobeItems[_i].integrity / clothingData(_slot,_wardrobeItems[_i],'integrity_max')))>>
			<</for>>
			<<if _descending>>
				<<set _sortedItemIntegrity to _itemIntegrity.sort()>>
			<<else>>
				<<set _sortedItemIntegrity to _itemIntegrity.sort(function(a, b){return b-a})>>
			<</if>>

			<<for _i to 0; _i lt _sortedItemIntegrity.length; _i++>>
				<<for _j to 0; _j lt _wardrobeItems.length; _j++>>
					<<if (_wardrobeItems[_j].integrity / clothingData(_slot,_wardrobeItems[_j],'integrity_max')) is _sortedItemIntegrity[_i]>>
						<<run _newWardrobeItems.push(clone(_wardrobeItems[_j]))>>
					<</if>>
				<</for>>
			<</for>>
		<<case "warmth">>
			<<set _itemWarmth to []>>
			<<for _i to 0; _i lt _wardrobeItems.length; _i++>>
				<<run _itemWarmth.pushUnique(_wardrobeItems[_i].warmth)>>
			<</for>>
			<<if _descending>>
				<<set _sortedItemWarmth to _itemWarmth.sort()>>
			<<else>>
				<<set _sortedItemWarmth to _itemWarmth.sort(function(a, b){return b-a})>>
			<</if>>

			<<for _i to 0; _i lt _sortedItemWarmth.length; _i++>>
				<<for _j to 0; _j lt _wardrobeItems.length; _j++>>
					<<if _wardrobeItems[_j].warmth is _sortedItemWarmth[_i]>>
						<<run _newWardrobeItems.push(clone(_wardrobeItems[_j]))>>
					<</if>>
				<</for>>
			<</for>>
		<<case "outfit">>
			<<if _descending>>
				<<set _status to ["broken","split",0,1]>> /* NO SPLIT ADDED */
			<<else>>
				<<set _status to [1,0,"split","broken"]>> /* NO SPLIT ADDED */
			<</if>>
			<<for _i to 0; _i lt _status.length; _i++>>
				<<for _j to 0; _j lt _wardrobeItems.length; _j++>>
					<<if _wardrobeItems[_j].one_piece is _status[_i]>>
						<<run _newWardrobeItems.push(clone(_wardrobeItems[_j]))>>
					<</if>>
				<</for>>
			<</for>>
		<<case "lewd">>
			<<set _itemReveal to []>>
			<<for _i to 0; _i lt _wardrobeItems.length; _i++>>
				<<run _itemReveal.pushUnique(_wardrobeItems[_i].reveal)>>
			<</for>>
			<<if _descending>>
				<<set _sortedItemReveal to _itemReveal.sort((a, b) => a - b)>>
			<<else>>
				<<set _sortedItemReveal to _itemReveal.sort((a, b) => b - a)>>
			<</if>>
			<<for _i to 0; _i lt _sortedItemReveal.length; _i++>>
				<<for _j to 0; _j lt _wardrobeItems.length; _j++>>
					<<if _wardrobeItems[_j].reveal is _sortedItemReveal[_i]>>
						<<run _newWardrobeItems.push(clone(_wardrobeItems[_j]))>>
					<</if>>
				<</for>>
			<</for>>
		<</switch>>

		<<if _newWardrobeItems isnot []>>
			<<set _selectedWardrobe[_slot] to clone(_newWardrobeItems)>>
		<</if>>
		<<run Dynamic.render()>>
	<</if>>
<</widget>>

<<widget "wardrobeSanityCheck">>
	/*Fixes invisible outfit bottoms caused by bugs in previous versions*/
	<<if $runWardrobeSanityChecker is true>>
		<<set $lastWardrobeSanityCheck to $saveVersions.last()>>
		/*Update _equip as required*/
		<<set _equip to ["lower", "under_lower", "head"]>>
		<<for _slot range _equip>>
			<<set _eIndextemIndex to {}>>
			<<for _eIndex to 0; _eIndex lt _selectedWardrobe[_slot].length; _eIndex++>>
				<<if _selectedWardrobe[_slot][_eIndex].outfitSecondary is undefined>>
					<<continue>>
				<</if>>
				<<if _selectedWardrobe[_slot][_eIndex].outfitSecondary[1] is "broken" or _selectedWardrobe[_slot][_eIndex].outfitSecondary[1] is "split">>
					<<continue>>
				<</if>>

				/*Prep*/
				<<set $_markBroken to true>>
				<<set $_found to false>>
				<<set _eIndextem to _selectedWardrobe[_slot][_eIndex]>>
				<<set $_outfitSecondary to _selectedWardrobe[_slot][_eIndex].outfitSecondary>>
				<<if _eIndextemIndex[$_outfitSecondary[0]] is undefined>>
					<<set _eIndextemIndex[$_outfitSecondary[0]] to []>>
				<</if>>

				/*Look for a primary piece that matches*/
				<<for _iIndex to 0; _iIndex lt _selectedWardrobe[$_outfitSecondary[0]].length; _iIndex++>>
					<<if _selectedWardrobe[$_outfitSecondary[0]][_iIndex].name isnot $_outfitSecondary[1]>>
						<<continue>>
					<</if>>
					<<if _eIndextemIndex[$_outfitSecondary[0]].includes(_iIndex)>>
						<<continue>>
					<</if>>

					<<if _selectedWardrobe[$_outfitSecondary[0]][_iIndex].colour is _eIndextem.colour and (_eIndextem.accessory is 0 or _selectedWardrobe[$_outfitSecondary[0]][_iIndex].accessory is 0 or _selectedWardrobe[$_outfitSecondary[0]][_iIndex].accessory_colour is _eIndextem.accessory_colour)>>
						<<if _eIndextem.colour isnot "custom" and (_eIndextem.accessory is 0 or _selectedWardrobe[$_outfitSecondary[0]][_iIndex].accessory is 0 or _eIndextem.accessory_colour isnot "custom")>>
							<<set $_markBroken to false>>
							<<run _eIndextemIndex[$_outfitSecondary[0]].push(clone(_iIndex))>>
							<<break>>
						<<elseif _eIndextem.colourCustom is _selectedWardrobe[$_outfitSecondary[0]][_iIndex].colourCustom and (_eIndextem.accessory is 0 or _selectedWardrobe[$_outfitSecondary[0]][_iIndex].accessory is 0 or _eIndextem.accessory_colourCustom is _selectedWardrobe[$_outfitSecondary[0]][_iIndex].accessory_colourCustom)>>
							<<set $_markBroken to false>>
							<<run _eIndextemIndex[$_outfitSecondary[0]].push(clone(_iIndex))>>
							<<break>>
						<</if>>
					<</if>>
				<</for>>
				<<if $_markBroken is true>>
					/*Mark as broken*/
					<<set _selectedWardrobe[_slot][_eIndex].outfitSecondary[1] to "broken">>
					<<set _selectedWardrobe[_slot][_eIndex].one_piece to "broken">>
					<<set _selectedWardrobe[_slot][_eIndex].set to clone(_slot)>>
					<<set _selectedWardrobe[_slot][_eIndex].sanityCheck to true>>
				<</if>>
			<</for>>
		<</for>>
		<<set $runWardrobeSanityChecker to false>>
	<</if>>
<</widget>>

<<widget "wardrobeGetRepairedClothes">>
	<<set _equip to setup.clothingLayer.all>>
	<<set _takenAway to 0>>
	<<for _eIndex to 0; _eIndex lt _equip.length; _eIndex++>>
		<<if $wardrobeRepair[_equip[_eIndex]] is undefined>>
			<<continue>>
		<</if>>
		<<for _iIndex to 0; _iIndex lt $wardrobeRepair[_equip[_eIndex]].length; _iIndex++>>
			<<set _itemStats to $wardrobeRepair[_equip[_eIndex]][_iIndex]>>
			<<if typeof _itemStats is "object" and _itemStats?.length >= 5>>
				/* Players might have old $wardrobeRepair already set before version updated */
				<<set _itemStats to {
					index: _itemStats[0],
					colour: _itemStats[1],
					colourCustom: _itemStats[2],
					accessory_colour: _itemStats[3],
					accessory_colourCustom: _itemStats[4],
					one_piece: _itemStats[5] === true ? "split" : undefined
				}>>
			<</if>>
			<<if _selectedWardrobe[_equip[_eIndex]].length gte _selectedWardrobe.space>>
				<<set _takenAwayCheckitem to setup.clothes[_equip[_eIndex]][_itemStats.index]>>
				<<if _takenAwayCheckitem.one_piece != 1>>
					<<set _takenAway++>>
					<<continue>>
				<</if>>
			<</if>>

			<<sendToWardrobeFromDefault "wardrobe" _equip[_eIndex] `_itemStats.index` `_itemStats.colour` `_itemStats.accessory_colour` `_itemStats.pattern`>>
			<<set _latestWardrobeAddition to _selectedWardrobe[_equip[_eIndex]].last()>>

			<<run Object.entries(_itemStats).forEach(([key, itemStatValue]) => {
				if (!itemStatValue) return;
				switch (key) {
					case "accessory_colour": case "accessory_colourCustom":
						if (!T.latestWardrobeAddition.accessory_colour_sidebar && T.itemStats.one_piece != "split") return;
						break;
					case "index": case "colour": case "pattern":
						return;
						break;
					case "altposition": case "altsleeve":
						if (!T.latestWardrobeAddition[key]) return;
						break;
					case "one_piece":
						if (T.latestWardrobeAddition[key] != 1) return;
						if (itemStatValue === "split") {
							if (T.latestWardrobeAddition.outfitPrimary) {
								Object.keys(T.latestWardrobeAddition.outfitPrimary).forEach((label) => {
									T.latestWardrobeAddition.outfitPrimary[label] = itemStatValue;
								})
							} else if (T.latestWardrobeAddition.outfitSecondary) {
								T.latestWardrobeAddition.outfitSecondary[1] = itemStatValue;
							}
						}
						break;
					case "hoodposition":
						if (!T.latestWardrobeAddition[key]) return;
						if (itemStatValue === "down") {
							delete T.latestWardrobeAddition.outfitPrimary.head;
							delete T.latestWardrobeAddition.outfitPrimary.over_head;
						}
						break;
				}
				T.latestWardrobeAddition[key] = itemStatValue;
			})>>
		<</for>>
	<</for>>
	<<if _takenAway gt 0>>
		<br>
		The driver thanks you for the donation of _takenAway items due to you not having enough space.
	<</if>>
	<<unset $wardrobeRepair>>
<</widget>>

<<widget "randomWear">>
	<<set $wardrobeOption to "wear">>
	<<set $_equip to []>>
	<<set _equipped to []>>
	<<for $_slot, $_value range $randomEquipConfigure>>
		<<if $worn[$_slot].type.includes("strap-on")>>
			<<continue>>
		<</if>>
		<<if $_value>>
			<<generalUndress $wardrobe_location $_slot>>
			<<run $_equip.push($_slot)>>
		<</if>>
	<</for>>
	<<for $_slot range $_equip>>
		<<if !_equipped.includes($_slot) and $worn[$_slot].name is "naked">>
			<<set _eIndexds to _selectedWardrobe[$_slot].map((item, index) => {
				if (!item.outfitSecondary or item.outfitSecondary[1] is "broken" or item.outfitSecondary[1] is "split") return index;
			}).filter(Boolean)>>
			<<if _eIndexds.length gt 0>>
				<<set _eIndexd to _eIndexds.random()>>
				<<set $_selectedItem to _selectedWardrobe[$_slot][_eIndexd]>>
					<<run _equipped.pushUnique($_slot)>>
					<<if $_selectedItem.outfitPrimary isnot undefined>>
						<<run Object.entries($_selectedItem.outfitPrimary).forEach((slot,value) => {
							if (value !== "broken" && value !== "split") _equipped.pushUnique(slot)
						})>>
					<</if>>
					<<set V["wear_" + $_slot] to _eIndexd>>
				<<unset _eIndexd>>
			<</if>>
		<</if>>
	<</for>>
	<<unset $randomWear>>
<</widget>>

<<widget "warmth_description">>
	<<print setup.WeatherDescriptions.warmthComfort()>>
	<hr />
<</widget>>

<<widget "wardrobeSelection">>
	<<if !$settings.multipleWardrobes or !$wardrobes[$wardrobe_location]>>
		<<set $wardrobe_location to "wardrobe">>
	<<elseif $forceWardrobeLocation>>
		<<set $wardrobe_location to $forceWardrobeLocation>>
	<<elseif $settings.multipleWardrobes is "isolated" and !$wardrobes[$wardrobe_location].isolated>>
		<<set $wardrobe_location to "wardrobe">>
	<</if>>
	<<if $debug and $settings.multipleWardrobes and !_args[0]>>
		<div class="no-numberify">Debug:
			<<for _label, _value range $wardrobes>>
				<<if _value.unlocked is undefined>>
				<<elseif $wardrobe_location is _label>>
					<span class="gold"><<print _value.name>></span> |
				<<else>>
					<<capture _label>><<link [[_value.name|$passage]]>><<set $forceWardrobeLocation to _label>><</link>> |<</capture>>
				<</if>>
			<</for>>
		</div>
		<br>
	<</if>>
<</widget>>

<<widget "cleanupOnWardrobeExit">>
  <<if $wardrobePreview isnot undefined and $wardrobePreview.active is true>><<wardrobePreviewDiscard>><</if>>
	<<if $bus is "clothingshop">><<set $tryOn.autoReset to true>><</if>>
	<<unset $saveColor>><<unset $wardrobeRepeat>><<unset $tempDisable>><<set $delete_outfit to "none">><<unset $forceWardrobeLocation>><<set $dontHide to false>><<run delete $wardrobeExit>>
<</widget>>

<<widget "wardrobeExits">>
	<!-- Note: Don't use $_ in this widget, because this widget gets <<replace>>'d into the passage body -->
	<!-- this widget doesn't make sense because these links ALWAYS depend on the passage this widget is called from, so there's no reason to make it a widget -->
	<<switch $passage>>
		<<case "Wardrobe">>
			<<link [[Close wardrobe|Bedroom]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "Changing Room">>
			<<if $exposed lte 1>>
				<<set _exit to $wardrobeExit or "Beach">>
				<<getouticon>><<link [[Leave|_exit]]>><<cleanupOnWardrobeExit>><</link>>
			<<elseif hasSexStat("exhibitionism", 5)>>
				<<set _exitSneak to $wardrobeExit or "Beach Changing Room Sneak">>
				<<sneakicon>><<link [[Sneak outside|_exitSneak]]>><<cleanupOnWardrobeExit>><</link>><<exhibitionist5>>
			<<else>>
				You can't go out like this!
			<</if>>
		<<case "Sydney Beach Changing Room">>
			<<set _earSlimeEnableSwimwear to true>>
			<<if $exposed lte 1>>
				<<getouticon>><<link [[Leave|Sydney Beach Swimsuit]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				You can't go out like this!
			<</if>>
		<<case "Sydney Beach Changing Room Leave">>
			<<set _earSlimeEnableSwimwear to true>>
			<<if $earSlime.forcedCommando isnot undefined and !$worn.under_lower.type.includes("naked") and $hypnosis_traits?.silence isnot 1>>
				<span class="red">The slime in your ear refuses to allow you to leave with <<underwearTypeText>> on.</span>
			<<elseif $exposed lte 1>>
				<<getouticon>><<link [[Leave|Sydney Beach Leave]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				You can't go out like this!
			<</if>>
		<<case "Eden Wardrobe">>
			<<if isLoveInterest("Eden") or hasSexStat("exhibitionism", 5) or $exposed lte 0 or (hasSexStat("exhibitionism", 4) and $exposed lte 1)>>
				<<link [[Done|Eden Cabin]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				You can't remain undressed like this!
			<</if>>
		<<case "Eden Night Wardrobe">>
			<<if isLoveInterest("Eden") or hasSexStat("exhibitionism", 5) or $exposed lte 0 or (hasSexStat("exhibitionism", 4) and $exposed lte 1)>>
				<<link [[Done|Eden Cabin Bed]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				You can't remain undressed like this!
			<</if>>
		<<case "Asylum Wardrobe">>
			<<if hasSexStat("exhibitionism", 5) or $exposed lte 0 or (hasSexStat("exhibitionism", 4) and $exposed lte 1)>>
				<<link [[Done|Asylum Cell]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				You can't remain undressed like this!
			<</if>>
		<<case "Farm Wardrobe">>
			<<if hasSexStat("exhibitionism", 5) or $exposed lte 0 or (hasSexStat("exhibitionism", 4) and $exposed lte 1)>>
				<<link [[Done|Farm Bedroom]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				You can't remain undressed like this!
			<</if>>
		<<case "Strip Club Wardrobe">>
			<<if hasSexStat("exhibitionism", 4) or $exposed lte 0 or (hasSexStat("exhibitionism", 2) and $exposed lte 1)>>
				<<link [[Step away|Strip Club Dressing Room]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				You can't go out like this!
			<</if>>
		<<case "Brothel Wardrobe">>
			<<if hasSexStat("exhibitionism", 4) or $exposed lte 0 or (hasSexStat("exhibitionism", 2) and $exposed lte 1)>>
				<<link [[Step away|Brothel Dressing Room]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				You can't go out like this!
			<</if>>
		<<case "School Pool Wardrobe">>
			<<if $changingRoomGender is "boys">>
				<<getouticon>><<link [[Leave|School Boy Changing Room]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				<<getouticon>><<link [[Leave|School Girl Changing Room]]>><<cleanupOnWardrobeExit>><</link>>
			<</if>>
		<<case "Farm Assault Wardrobe">>
			<<if hasSexStat("exhibitionism", 5) or $exposed lte 0 or (hasSexStat("exhibitionism", 4) and $exposed lte 1)>>
				<<link [[Done|Farm Assault Intro]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				You can't remain undressed like this!
			<</if>>
		<<case "Prison Wardrobe">>
			<<link [[Close|Prison Cell]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "Temple Wardrobe">>
			<<link [[Close|Temple Bunk]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "Pirate Wardrobe">>
			<<link [[Close|Pirate Bed]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "Office Agency Changing Room">>
			<<if $exposed lte 1>>
				<<getouticon>><<link [[Leave|Office Agency]]>><<cleanupOnWardrobeExit>><</link>>
			<<elseif hasSexStat("exhibitionism", 4)>>
				<<sneakicon>><<link [[Sneak outside|Office Agency Streak]]>><<cleanupOnWardrobeExit>><</link>><<exhibitionist4>>
			<<else>>
				You can't go out like this!
			<</if>>
		<<case "Bird Tower Wardrobe">>
			<<link [[Close|Bird Tower]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "Mansion Wardrobe">>
			<<if $avery_party>>
				<<link [[Exit|Mansion Party Quinn Change 2]]>><<cleanupOnWardrobeExit>><</link>>
				<br>
			<<elseif $avery_mansion_skyscraper_wardrobe>>
				<<link [[Exit|Mansion Skyscraper Wardrobe Exit]]>><<cleanupOnWardrobeExit>><</link>>
				<br>
			<<elseif $wardrobe_residential_alleys gte 2>>
				<<if $exposed lte 0>>
					<<link [[Exit|Residential Alleyways]]>><</link>>
					<br>
				<<elseif $exposed is 1 and hasSexStat("exhibitionism", 4)>>
					<<link [[Exit|Residential Mansion Undies]]>><</link>><<exhibitionist4>>
					<br>
				<<elseif $exposed is 2 and hasSexStat("exhibitionism", 5)>>
					<<link [[Exit|Residential Mansion Naked]]>><</link>><<exhibitionist5>>
					<br>
				<<else>>
					You can't leave dressed like this!
				<</if>>
			<<else>>
				<<link [[Exit|Mansion Bedroom]]>><<cleanupOnWardrobeExit>><</link>>
				<br>
			<</if>>
	<</switch>>
	<br><br>
<</widget>>

<<widget "underwearTypeText">><<silently>>
	<<if $worn.under_lower.name is "naked">>
	<<elseif $worn.under_lower.type.includes("swim")>>
		<<set $_text_output to "swimwear">>
	<<elseif $worn.under_lower.type.includes("dance")>>
		<<set $_text_output to "dancewear">>
	<<else>>
		<<set $_text_output to "underwear">>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>>
<</widget>>
